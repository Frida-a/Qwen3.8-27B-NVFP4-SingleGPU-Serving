+            and self.in_proj_ba.bias is None
+            and vllm_config.lora_config is None
+        )
         if (
             overlap_ba_proj
             and current_platform.is_cuda()
@@ -1408,6 +1420,12 @@ class QwenGatedDeltaNetAttention(GatedDeltaNetAttention):
         else:
             return self.forward_cuda(hidden_states)
 
+    def _in_proj_ba(self, hidden_states: torch.Tensor) -> torch.Tensor:
+        weight = self.in_proj_ba.weight
+        if self._ba_seqk and ba_seqk_applicable(hidden_states, weight):
+            return ba_seqk_gemm(hidden_states, weight)
+        return self.in_proj_ba(hidden_states)[0]
+
     def forward_cuda(
         self,
         hidden_states: torch.Tensor,
