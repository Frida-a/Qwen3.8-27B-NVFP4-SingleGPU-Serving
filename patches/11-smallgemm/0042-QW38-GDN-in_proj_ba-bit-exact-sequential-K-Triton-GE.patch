+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""[QW38 smallgemm] Small-M path for the GDN in_proj_ba GEMM (bf16, N = 2 * num_v_heads).
+
+On SM120 with M = 2..4 tokens (MTP k=3 decode at one request), cuBLAS picks
+`cutlass_80_wmma_tensorop_bf16_s161616gemm_bf16_16x16_128x2`: 8 single-warp CTAs
+walking K serially, ~34 us cold (~52 us in serving) for a ~1 MB weight. This kernel
+runs the same sequential k16 bf16 HMMA chain with fp32 accumulation (no split-K)
+and is bit-identical to that cuBLAS kernel at M = 2..4 (verified on SM120), at
+~9 us. Other M keep cuBLAS: M = 1 (gemv) and M >= 5 (split-K) reduce in a
+different order, so this kernel would not be exact there.
+Disable with VLLM_GDN_BA_SEQK=0.
+"""
+
+import os
+
+import torch
+
+from vllm.logger import init_logger
+from vllm.platforms import current_platform
+from vllm.triton_utils import tl, triton
+
+logger = init_logger(__name__)
+
+_BK = 512
+_ENABLED = os.environ.get("VLLM_GDN_BA_SEQK", "1") != "0"
+_logged = False
+_sm120: bool | None = None
+
+
+def _is_sm120() -> bool:
+    # Verified bit-exact on SM120 only (cuBLAS kernel choice is per arch).
+    global _sm120
+    if _sm120 is None:
+        _sm120 = current_platform.is_cuda() and torch.cuda.get_device_capability() == (12, 0)
+    return _sm120
+
+
+@triton.jit
+def _ba_seqk_kernel(
+    x_ptr, w_ptr, o_ptr, M, N, K, sxm, swn, som,
+    BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,
+):
+    # out^T tile [BN, BM] = W[BN, K] @ x[BM, K]^T, K walked in order (one acc chain).
+    pid_n = tl.program_id(0)
+    rm = tl.arange(0, BM)
+    rn = pid_n * BN + tl.arange(0, BN)
+    rk = tl.arange(0, BK)
+    xp = x_ptr + rm[:, None] * sxm + rk[None, :]
+    wp = w_ptr + rn[:, None] * swn + rk[None, :]
+    mm = rm[:, None] < M
+    mn = rn[:, None] < N
+    acc = tl.zeros((BN, BM), tl.float32)
+    for k0 in range(0, K, BK):
+        x = tl.load(xp + k0, mask=mm, other=0.0)
+        w = tl.load(wp + k0, mask=mn, other=0.0)
+        acc = tl.dot(w, tl.trans(x), acc)
+    tl.store(
+        o_ptr + rm[None, :] * som + rn[:, None],
+        acc.to(tl.bfloat16),
+        mask=(rm[None, :] < M) & (rn[:, None] < N),
+    )
+
+
+def ba_seqk_applicable(x: torch.Tensor, weight: torch.Tensor) -> bool:
+    return (
+        _ENABLED
+        and x.dim() == 2
+        and 2 <= x.shape[0] <= 4
+        and x.dtype == torch.bfloat16
+        and weight.dtype == torch.bfloat16
+        and x.is_cuda
+        and x.stride(1) == 1
+        and weight.stride(1) == 1
+        and x.shape[1] == weight.shape[1]
+        and weight.shape[1] % _BK == 0
+        and _is_sm120()
+    )
+
+
+def ba_seqk_gemm(x: torch.Tensor, weight: torch.Tensor) -> torch.Tensor:
+    global _logged
+    if not _logged:
+        _logged = True
+        logger.info(
+            "QW38 smallgemm: GDN in_proj_ba M=2..4 -> sequential-K Triton GEMM "
+            "(bit-exact vs cuBLAS wmma 16x16; N=%d K=%d).",
+            weight.shape[0], weight.shape[1],
+        )
+    M, K = x.shape
+    N = weight.shape[0]
+    out = torch.empty((M, N), dtype=x.dtype, device=x.device)
+    _ba_seqk_kernel[(triton.cdiv(N, 16),)](
+        x, weight, out, M, N, K, x.stride(0), weight.stride(0), out.stride(0),
+        BM=8, BN=16, BK=_BK, num_warps=1, num_stages=4,
+    )
+    return out
