From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Frida Hou <Frida-a@users.noreply.github.com>
Date: Thu, 12 Nov 2026 00:11:13 -0800
Subject: [PATCH] [GDN] int16 state tests: allow FMA-contraction ulp
 differences

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tests/kernels/mamba/test_gdn_state_int16.py | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/tests/kernels/mamba/test_gdn_state_int16.py b/tests/kernels/mamba/test_gdn_state_int16.py
index 0fd50cc74..8072594f6 100644
--- a/tests/kernels/mamba/test_gdn_state_int16.py
+++ b/tests/kernels/mamba/test_gdn_state_int16.py
@@ -64,7 +64,8 @@ def test_layout_and_ref_roundtrip():
     assert q.shape == (3, 4, gdn_int16_state_rows(V, K), K) == (3, 4, V + 2, K)
     y = dequantize_state_int16_ref(q, V)
     amax = x.abs().amax(-1, keepdim=True)
-    assert ((y - x).abs() <= 0.5 * amax / 32767.0 * 1.0001 + 1e-30).all()
+    # half an LSB, plus fp32 rounding of x * (32767 / amax)
+    assert ((y - x).abs() <= 0.51 * amax / 32767.0 + 1e-30).all()
     # zero rows stay exactly zero
     x[0, 0, 3] = 0
     y = dequantize_state_int16_ref(quantize_state_int16_ref(x), V)
@@ -131,7 +132,9 @@ def test_packed_decode_int16_matches_fp32(B, H, HV):
             use_qk_l2norm_in_kernel=True,
         )
     valid = idx > 0
-    torch.testing.assert_close(out16[valid], out32[valid], rtol=0, atol=0)
+    # Same fp32 math from the same starting values; only FMA contraction of the
+    # dequantize can differ, i.e. ~1 bf16 ulp on a few outputs.
+    torch.testing.assert_close(out16[valid], out32[valid], rtol=1e-2, atol=1e-3)
     _assert_int16_matches(cache16[idx[valid].long()], cache32[idx[valid].long()])
     assert torch.equal(cache16[0], untouched16)
 
@@ -181,8 +184,9 @@ def test_sigmoid_gating_update_int16_matches_fp32(num_spec):
         )
         outs.append(o)
     # Spec decode keeps the state in registers across the T tokens, so both
-    # paths do identical fp32 math from identical starting states.
-    torch.testing.assert_close(outs[0], outs[1], rtol=0, atol=0)
+    # paths do the same fp32 math from identical starting states (up to FMA
+    # contraction of the dequantize).
+    torch.testing.assert_close(outs[0], outs[1], rtol=1e-2, atol=1e-5)
     written = idx.flatten().long()
     _assert_int16_matches(cache16[written], cache32[written])
 
