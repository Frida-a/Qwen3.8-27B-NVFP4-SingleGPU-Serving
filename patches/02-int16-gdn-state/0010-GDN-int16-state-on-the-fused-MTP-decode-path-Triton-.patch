From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Frida Hou <Frida-a@users.noreply.github.com>
Date: Thu, 12 Nov 2026 01:45:38 -0800
Subject: [PATCH] [GDN] int16 state on the fused MTP decode path (Triton port
 on CUDA)

The CUDA fused_gdn_decode_post_conv_mtp op only supports fp32/bf16 states, so
int16 fell back to the unfused Triton spec path. Add STATE_INT16 to the Triton
port of the fused MTP kernel (load/re-quantize via gdn_state_int16 helpers) and
use it on CUDA when the state is int16. Unit test vs the same kernel on an fp32
state holding the dequantized values.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tests/kernels/mamba/test_gdn_state_int16.py   | 42 +++++++++++++++++++
 .../layers/mamba/gdn/qwen_gdn_linear_attn.py  | 15 +++++--
 .../ops/fused_gdn_decode_post_conv_mtp.py     | 41 ++++++++++++++----
 3 files changed, 87 insertions(+), 11 deletions(-)

diff --git a/tests/kernels/mamba/test_gdn_state_int16.py b/tests/kernels/mamba/test_gdn_state_int16.py
index 8072594f6..5138ece8b 100644
--- a/tests/kernels/mamba/test_gdn_state_int16.py
+++ b/tests/kernels/mamba/test_gdn_state_int16.py
@@ -227,3 +227,45 @@ def test_long_decode_drift():
     assert rel.max() < 1e-3, rel.max()
     rel_o = (out16.float() - out32.float()).norm() / out32.float().norm()
     assert rel_o < 1e-2, rel_o
+
+
+@pytest.mark.parametrize("N,T", [(3, 4), (40, 4), (5, 2)])
+def test_fused_mtp_triton_int16_matches_fp32(N, T):
+    """Triton port of the fused MTP decode (used on CUDA for the int16 state):
+    int16 cache vs fp32 cache holding the same dequantized values."""
+    from vllm.third_party.flash_linear_attention.ops.fused_gdn_decode_post_conv_mtp import (  # noqa: E501
+        fused_gdn_decode_post_conv_mtp_triton,
+    )
+
+    gen = torch.Generator(device=DEV).manual_seed(5)
+    H, HV = 16, 48
+    tokens = N * T
+    qkvz = torch.randn(
+        (tokens, 2 * H * K + 2 * HV * V), device=DEV, dtype=torch.bfloat16, generator=gen
+    )
+    mixed_qkv, z = qkvz.split([2 * H * K + HV * V, HV * V], dim=-1)
+    ba = torch.randn((tokens, 2 * HV), device=DEV, dtype=torch.bfloat16, generator=gen)
+    b, a = ba.chunk(2, dim=-1)
+    A_log = torch.randn((HV,), device=DEV, generator=gen)
+    dt_bias = torch.randn((HV,), device=DEV, generator=gen)
+    n_slots = 1 + N * T
+    s0 = _rand_state(n_slots, HV, gen)
+    cache16 = quantize_state_int16_ref(s0)
+    cache32 = dequantize_state_int16_ref(cache16, V).contiguous()
+    idx = torch.arange(1, n_slots, device=DEV, dtype=torch.int32).view(N, T)
+    acc = torch.randint(1, T + 1, (N,), device=DEV, dtype=torch.int32, generator=gen)
+    cu = torch.arange(0, tokens + 1, T, device=DEV, dtype=torch.int32)
+    w = torch.rand((V,), device=DEV, dtype=torch.bfloat16, generator=gen)
+    outs = []
+    for st in (cache16, cache32):
+        out = torch.empty((tokens, HV, V), device=DEV, dtype=torch.bfloat16)
+        fused_gdn_decode_post_conv_mtp_triton(
+            mixed_qkv=mixed_qkv, a=a, b=b, A_log=A_log, dt_bias=dt_bias,
+            state_indices=idx, cu_seqlens=cu, num_accepted_tokens=acc, state=st,
+            output_gate=z.view(tokens, HV, V), norm_weight=w, out=out,
+            scale=K**-0.5, norm_eps=1e-6, output_gate_activation="silu",
+        )
+        outs.append(out)
+    torch.testing.assert_close(outs[0], outs[1], rtol=2e-2, atol=2e-2)
+    written = idx.flatten().long()
+    _assert_int16_matches(cache16[written], cache32[written])
diff --git a/vllm/model_executor/layers/mamba/gdn/qwen_gdn_linear_attn.py b/vllm/model_executor/layers/mamba/gdn/qwen_gdn_linear_attn.py
index e19f2802c..d56d583c4 100644
--- a/vllm/model_executor/layers/mamba/gdn/qwen_gdn_linear_attn.py
+++ b/vllm/model_executor/layers/mamba/gdn/qwen_gdn_linear_attn.py
@@ -1044,7 +1044,7 @@ class QwenGatedDeltaNetAttention(GatedDeltaNetAttention):
             or self.norm.activation not in ("silu", "sigmoid")
             or vllm_config.model_config.dtype != torch.bfloat16
             or conv_state_dtype != torch.bfloat16
-            or recurrent_state_dtype not in FUSED_GDN_STATE_DTYPES
+            or recurrent_state_dtype not in (*FUSED_GDN_STATE_DTYPES, torch.int16)
             or not current_platform.has_device_capability(80)
         ):
             return (
@@ -1053,6 +1053,8 @@ class QwenGatedDeltaNetAttention(GatedDeltaNetAttention):
                 "layout, BF16 convolution cache, BF16 or FP32 recurrent "
                 "state, and a GPU with compute capability 8.0+"
             )
+        if recurrent_state_dtype == torch.int16:
+            return None  # int16 state: Triton port of the fused MTP decode
         if not supports_fused_mtp_decode():
             return "torch.ops._C.fused_gdn_decode_post_conv_mtp is not built"
         return None
@@ -2566,7 +2568,12 @@ class QwenGatedDeltaNetAttention(GatedDeltaNetAttention):
         assert num_accepted_tokens is not None
 
         num_requests = attn_metadata.num_spec_decodes
-        fused_mtp_decode_impl()(
+        mtp_impl = (
+            fused_gdn_decode_post_conv_mtp_triton
+            if self.kv_cache[1].dtype == torch.int16
+            else fused_mtp_decode_impl()
+        )
+        mtp_impl(
             mixed_qkv=mixed_qkv,
             a=a,
             b=b,
@@ -2624,13 +2631,13 @@ class QwenGatedDeltaNetAttention(GatedDeltaNetAttention):
             attn_metadata.spec_sequence_masks is not None
             and attn_metadata.num_decodes == 0
             and attn_metadata.num_spec_decodes > 0
-            and self.kv_cache[1].dtype in FUSED_GDN_STATE_DTYPES
+            and self.kv_cache[1].dtype in (*FUSED_GDN_STATE_DTYPES, torch.int16)
             and self.gdn_decode_kernel == "cuda"
             and self.num_v_heads % self.num_k_heads == 0
             and self.num_v_heads // self.num_k_heads in (1, 2, 3, 4, 8)
             and state_indices is not None
             and state_indices.size(1) <= MAX_FUSED_GDN_MTP_TOKENS
-            and supports_fused_mtp_decode()
+            and (supports_fused_mtp_decode() or self.kv_cache[1].dtype == torch.int16)
         )
 
     def _rms_norm_gated_cuda(
diff --git a/vllm/third_party/flash_linear_attention/ops/fused_gdn_decode_post_conv_mtp.py b/vllm/third_party/flash_linear_attention/ops/fused_gdn_decode_post_conv_mtp.py
index 0b7fc50c7..c84be5162 100644
--- a/vllm/third_party/flash_linear_attention/ops/fused_gdn_decode_post_conv_mtp.py
+++ b/vllm/third_party/flash_linear_attention/ops/fused_gdn_decode_post_conv_mtp.py
@@ -16,6 +16,11 @@ the whole value dimension, and writes the out_proj input.
 
 import torch
 
+from vllm.model_executor.layers.mamba.ops.gdn_state_int16 import (
+    gdn_int16_load_state,
+    gdn_int16_state_rows,
+    gdn_int16_store_state,
+)
 from vllm.triton_utils import tl, triton
 from vllm.utils.platform_utils import num_compute_units
 
@@ -45,7 +50,11 @@ def _gdn_mtp_update_kernel(
     K: tl.constexpr,
     V: tl.constexpr,
     BV: tl.constexpr,
+    STATE_INT16: tl.constexpr = False,
+    VP: tl.constexpr = 0,
 ):
+    # STATE_INT16: per head [VP, K] int16 = V rows of codes + fp32 row scales
+    # (gdn_state_int16.py); re-quantized on every stored token.
     i_v, i_n, i_hv = tl.program_id(0), tl.program_id(1), tl.program_id(2)
     NV: tl.constexpr = V // BV
     i_h = i_hv // (HV // H)
@@ -68,8 +77,15 @@ def _gdn_mtp_update_kernel(
             tl.store(p_sum_sq + t * HV * NV, 0.0)
         return
 
-    p_state = i_hv * V * K + o_v[:, None] * K + o_k[None, :]
-    b_h = tl.load(state + src * stride_state_slot + p_state).to(tl.float32)
+    if STATE_INT16:
+        mask_v = o_v < V
+        mask_h = mask_v[:, None] & (o_k < K)[None, :]
+        b_h = gdn_int16_load_state(
+            state + src * stride_state_slot + i_hv * VP * K, o_v, o_k, mask_v, mask_h, V, K
+        )
+    else:
+        p_state = i_hv * V * K + o_v[:, None] * K + o_k[None, :]
+        b_h = tl.load(state + src * stride_state_slot + p_state).to(tl.float32)
     neg_A = -tl.exp(tl.load(A_log + i_hv).to(tl.float32))
     bias = tl.load(dt_bias + i_hv).to(tl.float32)
     for t in range(num_tokens):
@@ -95,8 +111,14 @@ def _gdn_mtp_update_kernel(
 
         dst = tl.load(state_indices + i_n * stride_indices_row + t).to(tl.int64)
         if dst > 0:
-            p_dst = state + dst * stride_state_slot + p_state
-            tl.store(p_dst, b_h.to(state.dtype.element_ty))
+            if STATE_INT16:
+                gdn_int16_store_state(
+                    state + dst * stride_state_slot + i_hv * VP * K,
+                    b_h, o_v, o_k, mask_v, mask_h, V, K,
+                )
+            else:
+                p_dst = state + dst * stride_state_slot + p_state
+                tl.store(p_dst, b_h.to(state.dtype.element_ty))
 
 
 @triton.jit
@@ -152,7 +174,8 @@ def fused_gdn_decode_post_conv_mtp_triton(
 ) -> torch.Tensor:
     """Same arguments and result as `ops.fused_gdn_decode_post_conv_mtp`.
 
-    `out` and `output_gate` are [tokens, HV, V]; `state` is [slots, HV, V, K].
+    `out` and `output_gate` are [tokens, HV, V]; `state` is [slots, HV, V, K], or
+    [slots, HV, V + R, K] int16 codes + row scales (`--mamba-ssm-cache-dtype int16`).
     """
     HV, V = out.shape[-2:]
     K = state.shape[-1]
@@ -166,8 +189,10 @@ def fused_gdn_decode_post_conv_mtp_triton(
     assert a.shape == b.shape == (num_tokens, HV) and a.stride(1) == b.stride(1) == 1
     assert A_log.is_contiguous() and A_log.numel() == HV
     assert dt_bias.is_contiguous() and dt_bias.numel() == HV
-    assert state.dim() == 4 and state.shape[1:3] == (HV, V)
-    assert state.stride(1) == V * K and state.stride(2) == K and state.stride(3) == 1
+    state_int16 = state.dtype == torch.int16
+    VP = gdn_int16_state_rows(V, K) if state_int16 else V
+    assert state.dim() == 4 and state.shape[1:3] == (HV, VP)
+    assert state.stride(1) == VP * K and state.stride(2) == K and state.stride(3) == 1
     assert state_indices.dim() == 2 and state_indices.shape[0] == num_requests
     assert state_indices.stride(1) == 1 and cu_seqlens.is_contiguous()
     assert num_accepted_tokens.is_contiguous()
@@ -209,6 +234,8 @@ def fused_gdn_decode_post_conv_mtp_triton(
         K=K,
         V=V,
         BV=BV,
+        STATE_INT16=state_int16,
+        VP=VP,
         num_warps=4,
     )
     _gdn_mtp_gated_rmsnorm_kernel[(num_requests, HV, state_indices.shape[1])](
