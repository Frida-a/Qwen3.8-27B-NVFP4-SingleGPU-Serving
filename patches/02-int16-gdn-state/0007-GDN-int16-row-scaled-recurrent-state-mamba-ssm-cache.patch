+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""int16 row-scaled GDN recurrent state (`--mamba-ssm-cache-dtype int16`).
+
+Every kernel that reads/writes the int16 state is checked against the same
+kernel on an fp32 state that starts from identical (dequantized) values: the
+fp32 math must agree, and the stored state must equal the fp32 result
+re-quantized with the reference quantizer (codes within 1 LSB).
+"""
+
+import pytest
+import torch
+
+from vllm.model_executor.layers.mamba.ops.gather_initial_states import (
+    gather_initial_states,
+)
+from vllm.model_executor.layers.mamba.ops.gdn_state_int16 import (
+    dequantize_state_int16_ref,
+    gather_initial_states_int16,
+    gdn_int16_state_rows,
+    quantize_state_int16_ref,
+    scatter_states_int16,
+)
+from vllm.platforms import current_platform
+from vllm.third_party.flash_linear_attention.ops import (
+    fused_recurrent_gated_delta_rule_packed_decode,
+)
+from vllm.third_party.flash_linear_attention.ops.fused_sigmoid_gating import (
+    fused_sigmoid_gating_delta_rule_update,
+)
+
+pytestmark = pytest.mark.skipif(
+    not current_platform.is_cuda(), reason="int16 GDN state is CUDA-only"
+)
+DEV = "cuda"
+K = V = 128
+
+
+def _rand_state(n, HV, gen, scale=1.0):
+    s = torch.randn((n, HV, V, K), device=DEV, generator=gen) * scale
+    # heavy-tailed rows, as in real GDN states
+    s[:, :, ::7] *= 30.0
+    return s
+
+
+def _assert_int16_matches(packed: torch.Tensor, ref_fp32: torch.Tensor, rows=None):
+    """Packed int16 state == quantize_ref(ref_fp32) up to 1 LSB per element."""
+    expect = quantize_state_int16_ref(ref_fp32)
+    got_deq = dequantize_state_int16_ref(packed, V)
+    exp_deq = dequantize_state_int16_ref(expect, V)
+    scale = exp_deq.abs().amax(-1, keepdim=True) / 32767.0
+    err = (got_deq - exp_deq).abs()
+    assert (err <= 1.01 * scale + 1e-30).all(), float((err / (scale + 1e-30)).max())
+    # and the dequantized state is within half an LSB (+1 LSB slack) of fp32
+    err_ref = (got_deq - ref_fp32).abs()
+    assert (err_ref <= 1.51 * scale + 1e-30).all()
+
+
+def test_layout_and_ref_roundtrip():
+    gen = torch.Generator(device=DEV).manual_seed(0)
+    x = _rand_state(3, 4, gen)
+    q = quantize_state_int16_ref(x)
+    assert q.dtype == torch.int16
+    assert q.shape == (3, 4, gdn_int16_state_rows(V, K), K) == (3, 4, V + 2, K)
+    y = dequantize_state_int16_ref(q, V)
+    amax = x.abs().amax(-1, keepdim=True)
+    assert ((y - x).abs() <= 0.5 * amax / 32767.0 * 1.0001 + 1e-30).all()
+    # zero rows stay exactly zero
+    x[0, 0, 3] = 0
+    y = dequantize_state_int16_ref(quantize_state_int16_ref(x), V)
+    assert (y[0, 0, 3] == 0).all()
+
+
+@pytest.mark.parametrize("strided_idx", [False, True])
+def test_gather_scatter(strided_idx):
+    gen = torch.Generator(device=DEV).manual_seed(1)
+    HV, n_slots = 6, 9
+    x = _rand_state(n_slots, HV, gen)
+    cache = quantize_state_int16_ref(x)
+    idx_full = torch.tensor([3, 0, 7, 5, 1, 2], device=DEV, dtype=torch.int32)
+    idx = idx_full[::2] if strided_idx else idx_full[:3]
+    has = torch.tensor([True, False, True], device=DEV)
+    got = gather_initial_states_int16(cache, idx, has, V)
+    exp = dequantize_state_int16_ref(cache, V)[idx.long()]
+    exp[~has] = 0
+    torch.testing.assert_close(got, exp, rtol=0, atol=0)
+    # same semantics as the fp32 gather
+    ref = gather_initial_states(dequantize_state_int16_ref(cache, V), idx, has)
+    torch.testing.assert_close(got, ref, rtol=0, atol=0)
+
+    src = _rand_state(3, HV, gen, scale=3.0)
+    scatter_states_int16(cache, src, idx)
+    for j, slot in enumerate(idx.tolist()):
+        _assert_int16_matches(cache[slot : slot + 1], src[j : j + 1])
+
+
+def _gating_inputs(B, H, HV, gen, dtype=torch.bfloat16):
+    qkv = torch.randn((B, 2 * H * K + HV * V), device=DEV, dtype=dtype, generator=gen)
+    a = torch.randn((B, HV), device=DEV, dtype=dtype, generator=gen)
+    b = torch.randn((B, HV), device=DEV, dtype=dtype, generator=gen)
+    A_log = torch.randn((HV,), device=DEV, dtype=torch.float32, generator=gen)
+    dt_bias = torch.randn((HV,), device=DEV, dtype=torch.float32, generator=gen)
+    return qkv, a, b, A_log, dt_bias
+
+
+@pytest.mark.parametrize("B,H,HV", [(1, 16, 48), (7, 4, 12), (64, 16, 48)])
+def test_packed_decode_int16_matches_fp32(B, H, HV):
+    gen = torch.Generator(device=DEV).manual_seed(2)
+    qkv, a, b, A_log, dt_bias = _gating_inputs(B, H, HV, gen)
+    idx = torch.arange(1, B + 1, device=DEV, dtype=torch.int32)
+    if B > 3:
+        idx[-1] = 0  # padded slot: untouched, output zero
+    s0 = _rand_state(B + 1, HV, gen)
+    cache16 = quantize_state_int16_ref(s0)
+    cache32 = dequantize_state_int16_ref(cache16, V).contiguous()
+    untouched16 = cache16[0].clone()
+
+    out16 = torch.empty((B, 1, HV, V), device=DEV, dtype=torch.bfloat16)
+    out32 = torch.empty_like(out16)
+    for st, out in ((cache16, out16), (cache32, out32)):
+        fused_recurrent_gated_delta_rule_packed_decode(
+            mixed_qkv=qkv,
+            a=a,
+            b=b,
+            A_log=A_log,
+            dt_bias=dt_bias,
+            scale=K**-0.5,
+            initial_state=st,
+            out=out,
+            ssm_state_indices=idx,
+            use_qk_l2norm_in_kernel=True,
+        )
+    valid = idx > 0
+    torch.testing.assert_close(out16[valid], out32[valid], rtol=0, atol=0)
+    _assert_int16_matches(cache16[idx[valid].long()], cache32[idx[valid].long()])
+    assert torch.equal(cache16[0], untouched16)
+
+
+@pytest.mark.parametrize("num_spec", [0, 3])
+def test_sigmoid_gating_update_int16_matches_fp32(num_spec):
+    """Spec-decode (multi-token, per-token state slots, num_accepted_tokens)
+    and plain varlen decode."""
+    gen = torch.Generator(device=DEV).manual_seed(3)
+    N, H, HV = 5, 4, 12
+    T_per = num_spec + 1
+    T = N * T_per
+    q = torch.randn((1, T, H, K), device=DEV, dtype=torch.bfloat16, generator=gen)
+    k = torch.randn((1, T, H, K), device=DEV, dtype=torch.bfloat16, generator=gen)
+    v = torch.randn((1, T, HV, V), device=DEV, dtype=torch.bfloat16, generator=gen)
+    a = torch.randn((1, T, HV), device=DEV, dtype=torch.bfloat16, generator=gen)
+    b = torch.randn((1, T, HV), device=DEV, dtype=torch.bfloat16, generator=gen)
+    A_log = torch.randn((HV,), device=DEV, generator=gen)
+    dt_bias = torch.randn((HV,), device=DEV, generator=gen)
+    cu = torch.arange(0, T + 1, T_per, device=DEV, dtype=torch.int32)
+    n_slots = 1 + N * T_per
+    s0 = _rand_state(n_slots, HV, gen)
+    cache16 = quantize_state_int16_ref(s0)
+    cache32 = dequantize_state_int16_ref(cache16, V).contiguous()
+    if num_spec:
+        idx = torch.arange(1, n_slots, device=DEV, dtype=torch.int32).view(N, T_per)
+        acc = torch.tensor([1, 2, 4, 3, 1], device=DEV, dtype=torch.int32)
+    else:
+        idx = torch.arange(1, N + 1, device=DEV, dtype=torch.int32)
+        acc = None
+    outs = []
+    for st in (cache16, cache32):
+        o, _ = fused_sigmoid_gating_delta_rule_update(
+            A_log=A_log,
+            a=a,
+            b=b,
+            dt_bias=dt_bias,
+            q=q,
+            k=k,
+            v=v,
+            initial_state=st,
+            inplace_final_state=True,
+            cu_seqlens=cu,
+            ssm_state_indices=idx,
+            num_accepted_tokens=acc,
+            use_qk_l2norm_in_kernel=True,
+        )
+        outs.append(o)
+    # Spec decode keeps the state in registers across the T tokens, so both
+    # paths do identical fp32 math from identical starting states.
+    torch.testing.assert_close(outs[0], outs[1], rtol=0, atol=0)
+    written = idx.flatten().long()
+    _assert_int16_matches(cache16[written], cache32[written])
+
+
+def test_long_decode_drift():
+    """Re-quantizing every token for 4K steps stays close to the fp32 state."""
+    gen = torch.Generator(device=DEV).manual_seed(4)
+    B, H, HV, steps = 4, 2, 6, 4096
+    idx = torch.arange(1, B + 1, device=DEV, dtype=torch.int32)
+    cache32 = torch.zeros((B + 1, HV, V, K), device=DEV)
+    cache16 = quantize_state_int16_ref(cache32)
+    out16 = torch.empty((B, 1, HV, V), device=DEV, dtype=torch.bfloat16)
+    out32 = torch.empty_like(out16)
+    A_log = torch.full((HV,), -4.0, device=DEV)  # slow decay: long memory
+    dt_bias = torch.zeros((HV,), device=DEV)
+    for _ in range(steps):
+        qkv = torch.randn(
+            (B, 2 * H * K + HV * V), device=DEV, dtype=torch.bfloat16, generator=gen
+        )
+        a = torch.randn((B, HV), device=DEV, dtype=torch.bfloat16, generator=gen)
+        b = torch.randn((B, HV), device=DEV, dtype=torch.bfloat16, generator=gen)
+        for st, out in ((cache16, out16), (cache32, out32)):
+            fused_recurrent_gated_delta_rule_packed_decode(
+                mixed_qkv=qkv,
+                a=a,
+                b=b,
+                A_log=A_log,
+                dt_bias=dt_bias,
+                scale=K**-0.5,
+                initial_state=st,
+                out=out,
+                ssm_state_indices=idx,
+                use_qk_l2norm_in_kernel=True,
+            )
+    s16 = dequantize_state_int16_ref(cache16[1:], V)
+    s32 = cache32[1:]
+    rel = (s16 - s32).norm(dim=(-1, -2)) / s32.norm(dim=(-1, -2))
+    assert rel.max() < 1e-3, rel.max()
+    rel_o = (out16.float() - out32.float()).norm() / out32.float().norm()
+    assert rel_o < 1e-2, rel_o
