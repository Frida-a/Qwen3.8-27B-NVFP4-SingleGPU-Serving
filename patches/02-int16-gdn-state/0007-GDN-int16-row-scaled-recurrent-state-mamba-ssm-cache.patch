+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""INT16 row-scaled storage for the GatedDeltaNet recurrent state.
+
+`--mamba-ssm-cache-dtype int16` stores each per-sequence GDN state
+`[HV, V, K]` as int16 codes plus one fp32 scale per (head, v) row, packed into a
+single int16 tensor of shape `[HV, V + R, K]`: rows `0..V-1` hold the codes and
+the trailing `R = gdn_int16_scale_rows(V, K)` rows hold the `V` fp32 scales of
+that head (bit-cast). Keeping codes and scales in one dense block means every
+whole-block copy (prefix-cache "align" mode, spec-decode state moves) stays
+correct without knowing the format.
+
+Kernels compute in fp32 and re-quantize on every store:
+    scale = amax(|row|) / 32767,   code = clamp(rint(x / scale), +-32767)
+    load: x = code * scale
+This halves state traffic vs fp32 (2 + 4/K bytes per element).
+"""
+
+import torch
+
+from vllm.platforms import current_platform
+from vllm.triton_utils import tl, tldevice, triton
+
+INT16_QMAX = 32767.0
+
+
+def gdn_int16_scale_rows(head_v_dim: int, head_k_dim: int) -> int:
+    """Number of extra K-wide int16 rows per head that hold the V fp32 scales."""
+    scale_bytes = head_v_dim * 4
+    row_bytes = head_k_dim * 2
+    return -(-scale_bytes // row_bytes)
+
+
+def gdn_int16_state_rows(head_v_dim: int, head_k_dim: int) -> int:
+    return head_v_dim + gdn_int16_scale_rows(head_v_dim, head_k_dim)
+
+
+@triton.jit
+def gdn_int16_load_state(
+    p_head,  # int16 pointer to the head block [VP, K]
+    o_v,
+    o_k,
+    mask_v,
+    mask_h,
+    V: tl.constexpr,
+    K: tl.constexpr,
+):
+    """Load rows `o_v` of one head as fp32 [BV, BK]."""
+    b_code = tl.load(p_head + o_v[:, None] * K + o_k[None, :], mask=mask_h, other=0)
+    p_scale = (p_head + V * K).to(tl.pointer_type(tl.float32), bitcast=True)
+    b_scale = tl.load(p_scale + o_v, mask=mask_v, other=0.0)
+    return b_code.to(tl.float32) * b_scale[:, None]
+
+
+@triton.jit
+def gdn_int16_store_state(
+    p_head,
+    b_h,  # fp32 [BV, BK]
+    o_v,
+    o_k,
+    mask_v,
+    mask_h,
+    V: tl.constexpr,
+    K: tl.constexpr,
+):
+    """Re-quantize fp32 rows (one scale per row over K) and store them."""
+    b_amax = tl.max(tl.where(mask_h, tl.abs(b_h), 0.0), axis=1)
+    b_scale = b_amax * (1.0 / 32767.0)
+    b_inv = tl.where(b_amax > 0, 32767.0 / b_amax, 0.0)
+    b_q = tldevice.rint(b_h * b_inv[:, None])
+    b_q = tl.minimum(tl.maximum(b_q, -32767.0), 32767.0)
+    tl.store(
+        p_head + o_v[:, None] * K + o_k[None, :], b_q.to(tl.int16), mask=mask_h
+    )
+    p_scale = (p_head + V * K).to(tl.pointer_type(tl.float32), bitcast=True)
+    tl.store(p_scale + o_v, b_scale, mask=mask_v)
+
+
+# --------------------------------------------------------------------------
+# Prefill-side gather (dequantize) / scatter (quantize) of whole states.
+# --------------------------------------------------------------------------
+
+
+@triton.jit(do_not_specialize_on_alignment=["indices_ptr"])
+def _gather_int16_states_kernel(
+    state_ptr,
+    indices_ptr,
+    has_initial_state_ptr,
+    out_ptr,
+    stride_state_batch,
+    stride_indices,
+    stride_has_initial_state,
+    HV: tl.constexpr,
+    V: tl.constexpr,
+    VP: tl.constexpr,
+    K: tl.constexpr,
+    BV: tl.constexpr,
+    BK: tl.constexpr,
+):
+    i_v, i_hv, i_n = tl.program_id(0), tl.program_id(1), tl.program_id(2)
+    o_v = i_v * BV + tl.arange(0, BV)
+    o_k = tl.arange(0, BK)
+    mask_v = o_v < V
+    mask_h = mask_v[:, None] & (o_k < K)[None, :]
+    has_init = tl.load(has_initial_state_ptr + i_n * stride_has_initial_state).to(
+        tl.int1
+    )
+    p_out = out_ptr + ((i_n * HV + i_hv) * V + o_v[:, None]) * K + o_k[None, :]
+    if has_init:
+        state_idx = tl.load(indices_ptr + i_n * stride_indices).to(tl.int64)
+        p_head = state_ptr + state_idx * stride_state_batch + i_hv * VP * K
+        b_h = gdn_int16_load_state(p_head, o_v, o_k, mask_v, mask_h, V, K)
+    else:
+        b_h = tl.zeros([BV, BK], dtype=tl.float32)
+    tl.store(p_out, b_h, mask=mask_h)
+
+
+@triton.jit(do_not_specialize_on_alignment=["indices_ptr"])
+def _scatter_int16_states_kernel(
+    state_ptr,
+    src_ptr,
+    indices_ptr,
+    stride_state_batch,
+    stride_src_batch,
+    stride_indices,
+    V: tl.constexpr,
+    VP: tl.constexpr,
+    K: tl.constexpr,
+    BV: tl.constexpr,
+    BK: tl.constexpr,
+):
+    i_v, i_hv, i_n = tl.program_id(0), tl.program_id(1), tl.program_id(2)
+    o_v = i_v * BV + tl.arange(0, BV)
+    o_k = tl.arange(0, BK)
+    mask_v = o_v < V
+    mask_h = mask_v[:, None] & (o_k < K)[None, :]
+    state_idx = tl.load(indices_ptr + i_n * stride_indices).to(tl.int64)
+    p_src = (
+        src_ptr + i_n * stride_src_batch + (i_hv * V + o_v[:, None]) * K + o_k[None, :]
+    )
+    b_h = tl.load(p_src, mask=mask_h, other=0.0).to(tl.float32)
+    p_head = state_ptr + state_idx * stride_state_batch + i_hv * VP * K
+    gdn_int16_store_state(p_head, b_h, o_v, o_k, mask_v, mask_h, V, K)
+
+
+def _check_int16_state(state: torch.Tensor, head_v_dim: int) -> tuple[int, int, int]:
+    assert state.dtype == torch.int16 and state.ndim == 4
+    assert state[0].is_contiguous()
+    HV, VP, K = state.shape[1:]
+    assert VP == gdn_int16_state_rows(head_v_dim, K), (VP, head_v_dim, K)
+    return HV, VP, K
+
+
+def gather_initial_states_int16(
+    state: torch.Tensor,
+    indices: torch.Tensor,
+    has_initial_state: torch.Tensor,
+    head_v_dim: int,
+) -> torch.Tensor:
+    """fp32 `[n, HV, V, K]` initial states from an int16 GDN state cache;
+    rows without an initial state are zero."""
+    HV, VP, K = _check_int16_state(state, head_v_dim)
+    V = head_v_dim
+    assert indices.ndim == 1 and indices.shape == has_initial_state.shape
+    n = indices.numel()
+    out = torch.empty((n, HV, V, K), dtype=torch.float32, device=state.device)
+    if n == 0:
+        return out
+    BK = triton.next_power_of_2(K)
+    BV = min(triton.next_power_of_2(V), 16)
+    grid = (triton.cdiv(V, BV), HV, n)
+    _gather_int16_states_kernel[grid](
+        state,
+        indices,
+        has_initial_state,
+        out,
+        state.stride(0),
+        indices.stride(0),
+        has_initial_state.stride(0),
+        HV=HV,
+        V=V,
+        VP=VP,
+        K=K,
+        BV=BV,
+        BK=BK,
+        num_warps=4,
+    )
+    return out
+
+
+def scatter_states_int16(
+    state: torch.Tensor,
+    src: torch.Tensor,
+    indices: torch.Tensor,
+) -> None:
+    """Quantize fp32/bf16 `src [n, HV, V, K]` into the int16 cache at `indices`."""
+    V = src.shape[-2]
+    HV, VP, K = _check_int16_state(state, V)
+    assert src.shape[1:] == (HV, V, K) and src[0].is_contiguous()
+    assert indices.ndim == 1 and indices.shape[0] == src.shape[0]
+    n = indices.numel()
+    if n == 0:
+        return
+    BK = triton.next_power_of_2(K)
+    BV = min(triton.next_power_of_2(V), 16)
+    grid = (triton.cdiv(V, BV), HV, n)
+    _scatter_int16_states_kernel[grid](
+        state,
+        src,
+        indices,
+        state.stride(0),
+        src.stride(0),
+        indices.stride(0),
+        V=V,
+        VP=VP,
+        K=K,
+        BV=BV,
+        BK=BK,
+        num_warps=4,
+    )
+
+
+# --------------------------------------------------------------------------
+# Torch reference (tests, debugging).
+# --------------------------------------------------------------------------
+
+
+def quantize_state_int16_ref(x: torch.Tensor) -> torch.Tensor:
+    """fp32 `[..., HV, V, K]` -> packed int16 `[..., HV, V + R, K]`."""
+    *lead, V, K = x.shape
+    x = x.float()
+    amax = x.abs().amax(-1, keepdim=True)
+    scale = amax / INT16_QMAX
+    inv = torch.where(amax > 0, INT16_QMAX / amax, torch.zeros_like(amax))
+    code = torch.round(x * inv).clamp_(-INT16_QMAX, INT16_QMAX).to(torch.int16)
+    R = gdn_int16_scale_rows(V, K)
+    tail = torch.zeros((*lead, R * K // 2), dtype=torch.float32, device=x.device)
+    tail[..., :V] = scale.squeeze(-1)
+    tail = tail.view(torch.int16).reshape(*lead, R, K)
+    return torch.cat([code, tail], dim=-2)
+
+
+def dequantize_state_int16_ref(s: torch.Tensor, head_v_dim: int) -> torch.Tensor:
+    """packed int16 `[..., HV, V + R, K]` -> fp32 `[..., HV, V, K]`."""
+    V = head_v_dim
+    K = s.shape[-1]
+    code = s[..., :V, :].float()
+    scale = s[..., V:, :].contiguous().view(torch.float32).flatten(-2)[..., :V]
+    return code * scale.unsqueeze(-1)
+
+
+def is_int16_state_supported() -> bool:
+    return current_platform.is_cuda_alike()
