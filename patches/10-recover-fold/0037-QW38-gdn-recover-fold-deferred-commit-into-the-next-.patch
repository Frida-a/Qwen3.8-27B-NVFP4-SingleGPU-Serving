--- /dev/null
+++ b/tests/kernels/mamba/test_gdn_recover_fold.py
@@ -0,0 +1,365 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""GDN recover deferred commit (VLLM_GDN_RECOVER_FOLD=1) vs the eager commit.
+
+Reference: the shipped recover path, per step `gdn_recover_verify` (per-step
+row records, W = 1) followed by `GDNRecoverCommitGroup.commit` after sampling.
+Fold: `gdn_recover_verify` with request-row records + deferred trackers (the
+verify folds the previous step's accepted records and stores the state in
+place) followed by `commit_deferred`.
+
+A multi-step simulation drives both with identical inputs and checks, bit for
+bit, at every step:
+  * verify outputs;
+  * the stored state of every verified request after the fold verify equals
+    the reference's committed state of the previous step;
+  * prefix-cache boundary blocks (align mode) right after the commit.
+It covers random row order across steps, mixed batches (row_indices), requests
+skipping steps with pending records, align-mode boundary crossings (also the
+"boundary block is the running block" case), request finish / admission /
+preemption-resume with request-row and slot reuse, padded rows, int16 and
+fp32 states, and eager vs CUDA-graph (verify captured once, replayed with
+persistent padded buffers) execution.
+"""
+
+import random
+import zlib
+
+import pytest
+import torch
+
+from vllm.model_executor.layers.mamba.ops import gdn_recover_spec as grs
+from vllm.model_executor.layers.mamba.ops.gdn_recover_spec import (
+    GDNRecoverCommitGroup,
+    GDNRecoverDeferTrackers,
+    GDNRecoverRecords,
+    gdn_recover_defer_reset_requests,
+    gdn_recover_verify,
+)
+from vllm.model_executor.layers.mamba.ops.gdn_state_int16 import (
+    gdn_int16_state_rows,
+    quantize_state_int16_ref,
+)
+
+if not torch.cuda.is_available():
+    pytest.skip("GDN recover kernels need CUDA", allow_module_level=True)
+
+DEV = "cuda"
+K = V = 128
+H, HV = 16, 48
+NUM_SPEC = 7
+L = 2  # GDN layers in the commit group
+MAX_REQS = 6  # request-table rows
+N_PAD = 8  # padded spec rows (graph mode)
+NSLOTS = 320
+BS = 8  # mamba block size (tokens) for align mode
+MAX_BLOCKS = 128
+
+
+def _bits(x):
+    return x.view({4: torch.int32, 2: torch.int16}[x.element_size()])
+
+
+def _eq(got, ref, what):
+    if not torch.equal(_bits(got), _bits(ref)):
+        n = int((_bits(got) != _bits(ref)).sum())
+        d = (got.float() - ref.float()).abs().max().item()
+        raise AssertionError(f"{what}: {n}/{got.numel()} differ, max {d:.3e}")
+
+
+class _Req:
+    def __init__(self, rid, row, run_slot, blocks, computed):
+        self.rid, self.row, self.run_slot = rid, row, run_slot
+        self.blocks, self.computed = blocks, computed
+
+
+class _Sim:
+    def __init__(self, fmt, graph, align, mixed, seed, reset=True):
+        self.fmt, self.graph, self.align, self.mixed = fmt, graph, align, mixed
+        self.reset = reset
+        self.rng = random.Random(seed)
+        self.gen = torch.Generator(device=DEV).manual_seed(seed)
+        grs._DEFER_TRACKERS.clear()
+        VP = gdn_int16_state_rows(V, K) if fmt == "int16_row" else V
+        sdt = torch.int16 if fmt == "int16_row" else torch.float32
+        self.VP, self.sdt = VP, sdt
+        self.ref_states = [
+            torch.zeros((NSLOTS, HV, VP, K), dtype=sdt, device=DEV) for _ in range(L)
+        ]
+        self.fold_states = [s.clone() for s in self.ref_states]
+        mk = dict(
+            num_k_heads=H,
+            num_v_heads=HV,
+            head_k_dim=K,
+            head_v_dim=V,
+            num_spec=NUM_SPEC,
+            dtype=torch.bfloat16,
+            device=DEV,
+        )
+        self.ref_rec = [
+            GDNRecoverRecords.allocate(num_slots=N_PAD, by_row=True, **mk)
+            for _ in range(L)
+        ]
+        self.fold_rec = [
+            GDNRecoverRecords.allocate(num_slots=MAX_REQS, by_req=True, **mk)
+            for _ in range(L)
+        ]
+        self.defer = GDNRecoverDeferTrackers.allocate(MAX_REQS, DEV)
+        self.ref_group = GDNRecoverCommitGroup(self.ref_states, self.ref_rec, H)
+        self.fold_group = GDNRecoverCommitGroup(
+            self.fold_states, self.fold_rec, H, defer=self.defer
+        )
+        self.A_log = [
+            torch.log(torch.rand(HV, generator=self.gen, device=DEV) * 15 + 1)
+            for _ in range(L)
+        ]
+        self.dt_bias = [torch.randn(HV, generator=self.gen, device=DEV) for _ in range(L)]
+        self.free_rows = list(range(MAX_REQS))
+        self.free_slots = list(range(1, NSLOTS))
+        self.reqs: dict[int, _Req] = {}
+        self.next_rid = 0
+        # Reference committed states of the previous step (per slot), to
+        # compare with the fold path's in-place store.
+        self.prev_ref = None
+        if graph:
+            self._init_graph()
+
+    # ---- request lifecycle -------------------------------------------------
+    def _prefill_state(self, slot):
+        x = torch.randn((HV, V, K), generator=self.gen, device=DEV) * 0.05
+        st = quantize_state_int16_ref(x) if self.fmt == "int16_row" else x
+        for s in self.ref_states + self.fold_states + (self.prev_ref or []):
+            s[slot] = st
+
+    def admit(self, row=None, reuse_slot=None):
+        if not self.free_rows:
+            return None
+        row = row if row is not None else self.rng.choice(self.free_rows)
+        self.free_rows.remove(row)
+        if reuse_slot is not None and reuse_slot in self.free_slots:
+            run_slot = reuse_slot
+        else:
+            run_slot = self.rng.choice(self.free_slots)
+        self.free_slots.remove(run_slot)
+        computed = self.rng.randrange(1, 40)
+        blocks = []
+        r = _Req(self.next_rid, row, run_slot, blocks, computed)
+        self.next_rid += 1
+        self.reqs[r.rid] = r
+        self._prefill_state(run_slot)
+        # The runner's add_request: drop records a predecessor left here.
+        if self.reset:
+            gdn_recover_defer_reset_requests(row)
+        return r
+
+    def free(self, r):
+        del self.reqs[r.rid]
+        self.free_rows.append(r.row)
+        self.free_slots.append(r.run_slot)
+        self.free_slots.extend(b for b in r.blocks if b != r.run_slot)
+
+    def _ensure_blocks(self, r, upto_tokens):
+        need = upto_tokens // BS + 1
+        while len(r.blocks) < need:
+            if self.rng.random() < 0.15 and r.run_slot not in r.blocks:
+                r.blocks.append(r.run_slot)  # boundary block == running block
+            else:
+                b = self.rng.choice(self.free_slots)
+                self.free_slots.remove(b)
+                r.blocks.append(b)
+
+    # ---- graph mode ------------------------------------------------------------
+    def _init_graph(self):
+        T_max = N_PAD * (NUM_SPEC + 1)
+        conv = 2 * H * K + HV * V
+        self.g_qkv = [torch.zeros((T_max, conv), dtype=torch.bfloat16, device=DEV) for _ in range(L)]
+        self.g_ba = [torch.zeros((T_max, 2 * HV), dtype=torch.bfloat16, device=DEV) for _ in range(L)]
+        self.g_out = [torch.zeros((T_max, HV, V), dtype=torch.bfloat16, device=DEV) for _ in range(L)]
+        self.g_cu = torch.zeros(N_PAD + 1, dtype=torch.int32, device=DEV)
+        self.g_slot = torch.zeros(N_PAD, dtype=torch.int32, device=DEV)
+        self.g_req = torch.zeros(N_PAD, dtype=torch.int32, device=DEV)
+        self.graphs = []
+
+        def run():
+            for i in range(L):
+                qkv, ba = self.g_qkv[i], self.g_ba[i]
+                gdn_recover_verify(
+                    qkv[:, : H * K].view(-1, H, K),
+                    qkv[:, H * K : 2 * H * K].view(-1, H, K),
+                    qkv[:, 2 * H * K :].view(-1, HV, V),
+                    ba[:, HV:],
+                    ba[:, :HV],
+                    self.A_log[i],
+                    self.dt_bias[i],
+                    self.fold_states[i],
+                    self.fold_rec[i],
+                    cu_seqlens=self.g_cu,
+                    slot_indices=self.g_slot,
+                    out=self.g_out[i],
+                    req_indices=self.g_req,
+                    defer=self.defer,
+                )
+
+        # Warm up (compile) on an all-padding batch, then capture.
+        run()
+        torch.cuda.synchronize()
+        g = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(g):
+            run()
+        self.graph_obj = g
+
+    # ---- one step ------------------------------------------------------------
+    def step(self):
+        rng = self.rng
+        # Lifecycle events.
+        live = list(self.reqs.values())
+        if live and rng.random() < 0.25:
+            r = rng.choice(live)
+            row, slot = r.row, r.run_slot
+            self.free(r)
+            if rng.random() < 0.5:
+                # Preemption/resume or immediate reuse: same request row and
+                # often the same running slot, while records are pending.
+                self.admit(row=row, reuse_slot=slot if rng.random() < 0.5 else None)
+        while len(self.reqs) < 3 or (self.free_rows and rng.random() < 0.3):
+            if self.admit() is None:
+                break
+        # Batch: a random subset in random order (others skip this step).
+        live = list(self.reqs.values())
+        rng.shuffle(live)
+        batch = [r for r in live if rng.random() < 0.85] or live[:1]
+        batch = batch[:N_PAD]
+        N = len(batch)
+        qlens = [rng.randint(1, NUM_SPEC + 1) for _ in batch]
+        # Mixed batch: non-spec rows interleaved (row_indices).
+        if self.mixed:
+            B = N + rng.randint(1, 3)
+            rows = sorted(rng.sample(range(B), N))
+        else:
+            B, rows = N, list(range(N))
+        num_acc = torch.ones(B, dtype=torch.int32)
+        for n, r in enumerate(batch):
+            # Includes 0 (clamped to 1) and > qlen (clamped).
+            num_acc[rows[n]] = rng.randint(0, qlens[n] + 1)
+        block_table = torch.zeros((B, MAX_BLOCKS), dtype=torch.int32)
+        num_comp = torch.zeros(B, dtype=torch.int32)
+        for n, r in enumerate(batch):
+            self._ensure_blocks(r, r.computed + qlens[n])
+            block_table[rows[n], : len(r.blocks)] = torch.tensor(r.blocks)
+            num_comp[rows[n]] = r.computed
+        cu = torch.zeros(N + 1, dtype=torch.int32)
+        cu[1:] = torch.cumsum(torch.tensor(qlens), 0)
+        T = int(cu[-1])
+        slots = torch.tensor([r.run_slot for r in batch], dtype=torch.int32)
+        reqs = torch.tensor([r.row for r in batch], dtype=torch.int32)
+        cu_d, slots_d, reqs_d = cu.to(DEV), slots.to(DEV), reqs.to(DEV)
+        num_acc_d, bt_d, nc_d = num_acc.to(DEV), block_table.to(DEV), num_comp.to(DEV)
+        row_idx = torch.tensor(rows, dtype=torch.int32, device=DEV) if self.mixed else None
+        conv = 2 * H * K + HV * V
+        qkv = [(torch.randn((T, conv), generator=self.gen, device=DEV) * 0.5).to(torch.bfloat16) for _ in range(L)]
+        ba = [torch.randn((T, 2 * HV), generator=self.gen, device=DEV).to(torch.bfloat16) for _ in range(L)]
+
+        def args(i):
+            x = qkv[i]
+            return (
+                x[:, : H * K].view(T, H, K),
+                x[:, H * K : 2 * H * K].view(T, H, K),
+                x[:, 2 * H * K :].view(T, HV, V),
+                ba[i][:, HV:],
+                ba[i][:, :HV],
+                self.A_log[i],
+                self.dt_bias[i],
+            )
+
+        # Reference: verify (eager) then commit.
+        ref_out = []
+        for i in range(L):
+            ref_out.append(
+                gdn_recover_verify(
+                    *args(i), self.ref_states[i], self.ref_rec[i],
+                    cu_seqlens=cu_d, slot_indices=slots_d,
+                )
+            )
+        # Fold: verify (eager or graph replay).
+        if self.graph:
+            for i in range(L):
+                self.g_qkv[i][:T].copy_(qkv[i])
+                self.g_ba[i][:T].copy_(ba[i])
+            self.g_cu.fill_(T)
+            self.g_cu[: N + 1].copy_(cu_d)
+            self.g_slot.zero_()
+            self.g_slot[:N].copy_(slots_d)
+            self.g_req.zero_()
+            self.g_req[:N].copy_(reqs_d)
+            self.graph_obj.replay()
+            fold_out = [self.g_out[i][:T] for i in range(L)]
+        else:
+            # Padded rows (slot 0, request row 0) as the builder stages them.
+            pad = rng.randint(0, 2)
+            cu_p = torch.cat([cu_d, cu_d[-1:].repeat(pad)])
+            sl_p = torch.cat([slots_d, torch.zeros(pad, dtype=torch.int32, device=DEV)])
+            rq_p = torch.cat([reqs_d, torch.zeros(pad, dtype=torch.int32, device=DEV)])
+            fold_out = [
+                gdn_recover_verify(
+                    *args(i), self.fold_states[i], self.fold_rec[i],
+                    cu_seqlens=cu_p, slot_indices=sl_p,
+                    req_indices=rq_p, defer=self.defer,
+                )
+                for i in range(L)
+            ]
+        for i in range(L):
+            _eq(fold_out[i], ref_out[i], f"layer {i} verify output")
+        # The fold verify stored the previous step's committed state in place.
+        if self.prev_ref is not None:
+            for i in range(L):
+                for r in batch:
+                    _eq(
+                        self.fold_states[i][r.run_slot],
+                        self.prev_ref[i][r.run_slot],
+                        f"layer {i} slot {r.run_slot} state after fold",
+                    )
+        align = dict(
+            block_table=bt_d if self.align else None,
+            num_computed_tokens=nc_d if self.align else None,
+            mamba_block_size=BS if self.align else 0,
+        )
+        self.ref_group.commit(slots_d, cu_d, num_acc_d, row_indices=row_idx, **align)
+        self.fold_group.commit_deferred(
+            slots_d, cu_d, num_acc_d, reqs_d, row_indices=row_idx, **align
+        )
+        torch.cuda.synchronize()
+        # Boundary blocks are written at commit time in both paths.
+        if self.align:
+            for i in range(L):
+                for r in self.reqs.values():
+                    for b in r.blocks:
+                        if b != r.run_slot:
+                            _eq(self.fold_states[i][b], self.ref_states[i][b],
+                                f"layer {i} boundary block {b}")
+        self.prev_ref = [s.clone() for s in self.ref_states]
+        # Advance computed tokens by the accepted count (clamped as the plan).
+        for n, r in enumerate(batch):
+            r.computed += max(1, min(int(num_acc[rows[n]]), qlens[n]))
+        return N
+
+
+@pytest.mark.parametrize("fmt", ["int16_row", "fp32"])
+@pytest.mark.parametrize("graph", [False, True])
+@pytest.mark.parametrize("align", [False, True])
+@pytest.mark.parametrize("mixed", [False, True])
+def test_recover_fold_matches_eager_commit(fmt, graph, align, mixed):
+    seed = zlib.crc32(f"{fmt}{graph}{align}{mixed}".encode())
+    sim = _Sim(fmt, graph, align, mixed, seed=seed)
+    rows = 0
+    for _ in range(60):
+        rows += sim.step()
+    assert rows > 150
+
+
+def test_recover_fold_detects_missing_admission_reset():
+    """Negative control: without the admission reset a reused request row
+    folds its predecessor's records, and the comparison must catch it."""
+    sim = _Sim("int16_row", False, False, False, seed=7, reset=False)
+    with pytest.raises(AssertionError):
+        for _ in range(200):
+            sim.step()
