     VLLM_GDN_SPEC_STATE_W: int = 1
+    VLLM_GDN_RECOVER_FOLD: bool = False
     VLLM_DISABLE_PYNCCL: bool = False
     VLLM_USE_OINK_OPS: bool = False
     VLLM_MXFP4_EMULATION_DEQUANT_AT_LOAD: bool = False
@@ -1325,6 +1326,13 @@ environment_variables: dict[str, Callable[[], Any]] = {
     # ring and are folded into the state once W tokens are pending (the verify
     # replays them in registers); 1 folds every step.
     "VLLM_GDN_SPEC_STATE_W": lambda: int(os.getenv("VLLM_GDN_SPEC_STATE_W", "1")),
+    # VLLM_GDN_SPEC_STATE=recover with W = 1: defer each step's commit into the
+    # next step's verify (fold the accepted records, store the state in place,
