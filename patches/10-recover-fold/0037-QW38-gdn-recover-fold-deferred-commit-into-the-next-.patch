+                    vllm_config.scheduler_config.max_num_seqs,
+                    self._recover_records.ring_len,
+                )
         if self.spec_recover:
             reason = self._spec_recover_unsupported_reason(vllm_config)
             if reason is not None:
@@ -2312,6 +2325,12 @@ class QwenGatedDeltaNetAttention(GatedDeltaNetAttention):
             scale=self.head_k_dim**-0.5,
             window=window,
             trackers=trackers,
+            req_indices=getattr(attn_metadata, "recover_req_indices", None)
+            if getattr(self, "recover_fold", False)
+            else None,
+            defer=getattr(attn_metadata, "recover_defer", None)
