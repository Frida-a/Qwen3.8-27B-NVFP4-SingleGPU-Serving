                 current_platform.current_device(),
-                by_row=True,
+                by_row=not self.recover_fold,
+                by_req=self.recover_fold,
             )
+            if self.recover_fold:
+                logger.info_once(
+                    "GDN recover fold (QW38): deferred commit, records %.1f MiB "
+                    "per GDN layer (%d request rows, ring %d)",
