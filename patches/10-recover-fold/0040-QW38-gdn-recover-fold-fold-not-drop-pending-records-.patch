         while len(self.reqs) < 3 or (self.free_rows and rng.random() < 0.3):
             if self.admit() is None:
                 break
+        if self.prefill_flush and self.reqs and rng.random() < 0.35:
+            self._prefill_row(rng.choice(list(self.reqs.values())))
         # Batch: a random subset in random order (others skip this step).
         live = list(self.reqs.values())
         rng.shuffle(live)
@@ -421,3 +446,26 @@ def test_recover_fold_crossings_exercised():
         sim.step()
         n = max(n, sum(len(r.crossed) for r in sim.reqs.values()))
     assert n >= 3
+
