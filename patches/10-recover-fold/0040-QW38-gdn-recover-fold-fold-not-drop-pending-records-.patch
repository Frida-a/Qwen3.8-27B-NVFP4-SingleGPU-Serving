+    def _recover_group_ready(self) -> bool:
+        """The group's GDN layers are bound to a real KV cache (not during the
+        memory profile run)."""
+        ctx = self.vllm_config.compilation_config.static_forward_context
+        for name in self.layer_names:
+            kv = getattr(ctx.get(name), "kv_cache", None)
+            if (
+                not isinstance(kv, (list, tuple))
+                or len(kv) < 2
+                or not torch.is_tensor(kv[1])
+                or kv[1].numel() == 0
+                or kv[1].device.type != "cuda"
+            ):
+                return False
+        return True
+
+    def _recover_fold_nonspec_rows(
+        self,
+        rows: torch.Tensor,
+        req: torch.Tensor,
+        state_table: torch.Tensor,
+    ) -> None:
+        """Fold the records pending in the request-table rows `req` into the
+        running state of batch rows `rows` (state_table[rows, 0]) and clear
+        them, in this cache group. A no-op for rows with nothing pending."""
+        assert self._recover_defer is not None
+        if not self._recover_group_ready():
+            # Nothing can be pending before the KV cache exists.
+            self._recover_defer.reset(req)
+            return
+        slots = state_table[:, 0].index_select(0, rows)
+        group = self.recover_commit_group()
+        group.flush_deferred(slots, req, counter=self._recover_fold_debug)
+        if self._recover_fold_debug is not None:
+            self._recover_fold_debug_calls += 1
+            calls = self._recover_fold_debug_calls
+            nrows, nrec = self._recover_fold_debug.tolist()
+            if nrows != self._recover_fold_debug_rows or calls % 50 == 1:
+                self._recover_fold_debug_rows = nrows
+                logger.info(
+                    "GDN recover fold debug (group %s): non-spec row folds: "
+                    "%d calls, %d rows with pending records, %d records",
+                    self.layer_names[0],
+                    calls,
+                    nrows,
+                    nrec,
+                )
+
     def _recover_flush(self, slots: torch.Tensor | None) -> None:
         """Fold the pending records of slots read outside the spec verify
         (prefill / non-spec decode rows) and reset their ring trackers.
