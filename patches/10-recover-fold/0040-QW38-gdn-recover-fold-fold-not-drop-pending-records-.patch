-    def __init__(self, fmt, graph, align, mixed, seed, reset=True, stale_read=False):
+    def __init__(self, fmt, graph, align, mixed, seed, reset=True, stale_read=False,
+                 prefill_flush=None):
         self.fmt, self.graph, self.align, self.mixed = fmt, graph, align, mixed
         self.reset = reset
         # Negative control: the fold path verifies one request off a poisoned
         # (never written) block, as a read-before-store bug would.
         self.stale_read = stale_read
+        # A request with pending records turns into a non-spec (prefill) row:
+        # "fold" = the builder's flush_deferred (must match the eager commit),
+        # "drop" = 5414a0131's reset of those rows (negative control).
+        self.prefill_flush = prefill_flush
+        self.flush_counter = torch.zeros(2, dtype=torch.int64, device=DEV)
         self.rng = random.Random(seed)
         self.gen = torch.Generator(device=DEV).manual_seed(seed)
         grs._DEFER_TRACKERS.clear()
@@ -187,6 +193,23 @@ class _Sim:
             else:
                 s[b].fill_(float("nan"))
 
+    def _prefill_row(self, r):
+        """The request runs as a non-spec row this step: its state is read by
+        the prefill kernels, so the fold path must first fold its pending
+        records (the reference has none). Then the prefill writes a new state."""
+        slots = torch.tensor([r.run_slot], dtype=torch.int32, device=DEV)
+        rows = torch.tensor([r.row], dtype=torch.int32, device=DEV)
+        if self.prefill_flush == "fold":
+            self.fold_group.flush_deferred(slots, rows, counter=self.flush_counter)
+        else:
+            self.defer.reset(rows)
+        torch.cuda.synchronize()
+        assert int(self.defer.pending[r.row]) == 0
+        for i in range(L):
+            _eq(self.fold_states[i][r.run_slot], self.ref_states[i][r.run_slot],
+                f"layer {i} slot {r.run_slot} state read by a prefill row")
+        self._prefill_state(r.run_slot)
+
     # ---- graph mode ------------------------------------------------------------
     def _init_graph(self):
         T_max = N_PAD * (NUM_SPEC + 1)
