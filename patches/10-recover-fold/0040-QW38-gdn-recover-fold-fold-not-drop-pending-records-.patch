+@pytest.mark.parametrize("fmt", ["int16_row", "fp32"])
+@pytest.mark.parametrize("align", [False, True])
+def test_recover_fold_prefill_row_folds_pending(fmt, align):
+    """A request with pending records that becomes a non-spec (prefill) row:
+    the builder's flush_deferred folds them into its state first, so the
+    prefill reads exactly the eager commit's state."""
+    seed = zlib.crc32(f"prefill{fmt}{align}".encode())
+    sim = _Sim(fmt, False, align, True, seed=seed, prefill_flush="fold")
+    for _ in range(60):
+        sim.step()
+    rows, records = sim.flush_counter.tolist()
+    assert rows >= 5 and records >= rows, (rows, records)  # really exercised
+
+
+def test_recover_fold_detects_prefill_row_drop():
+    """Negative control: dropping the pending records (5414a0131's reset of
+    non-spec rows) instead of folding them must fail the gate."""
+    sim = _Sim("int16_row", False, False, True, seed=5, prefill_flush="drop")
+    with pytest.raises(AssertionError):
+        for _ in range(60):
+            sim.step()
diff --git a/vllm/model_executor/layers/mamba/ops/gdn_recover_spec.py b/vllm/model_executor/layers/mamba/ops/gdn_recover_spec.py
index 9ba787927..038f6bac4 100644
--- a/vllm/model_executor/layers/mamba/ops/gdn_recover_spec.py
+++ b/vllm/model_executor/layers/mamba/ops/gdn_recover_spec.py
@@ -889,6 +889,43 @@ def _gdn_recover_defer_plan_kernel(
     tl.store(defer_pending + req, tl.where(forced, 0, n_acc), mask=valid)
 
 
+@triton.heuristics({"COUNT": lambda args: args["counter"] is not None})
+@triton.jit
+def _gdn_recover_defer_flush_plan_kernel(
+    slot_indices,
+    req_indices,
+    defer_half,
+    defer_pending,
+    plan,
+    counter,
+    HALF: tl.constexpr,
+    COUNT: tl.constexpr,
+):
+    """Deferred commit, before a non-spec (prefill) row reads its state: fold
+    the records still pending in its request-table row into its running slot
+    (plan count > 0) and clear them. Rows without a slot only clear them.
+
+    plan[n] = (src, dst, start, count, 0, 0, rec, 0)."""
+    i_n = tl.program_id(0)
+    p_plan = plan + i_n * 8
+    slot = tl.load(slot_indices + i_n).to(tl.int32)
+    req = tl.load(req_indices + i_n).to(tl.int64)
+    pending = tl.load(defer_pending + req)
+    count = tl.where(slot > 0, pending, 0)
+    tl.store(p_plan + 0, slot)
+    tl.store(p_plan + 1, slot)
+    tl.store(p_plan + 2, tl.load(defer_half + req) * HALF)
+    tl.store(p_plan + 3, count)
+    tl.store(p_plan + 4, 0)
+    tl.store(p_plan + 5, 0)
+    tl.store(p_plan + 6, req.to(tl.int32))
+    tl.store(p_plan + 7, 0)
+    tl.store(defer_pending + req, 0)
+    if COUNT:
+        tl.atomic_add(counter + 0, (count > 0).to(tl.int64))
+        tl.atomic_add(counter + 1, count.to(tl.int64))
+
+
 @triton.jit
 def _gdn_recover_commit_kernel(
     state_addrs,
@@ -1166,6 +1203,34 @@ class GDNRecoverCommitGroup:
             # Only crossing rows have a nonzero count; the others exit early.
             self._launch_commit(plan, N)
 
+    def flush_deferred(
+        self,
+        slot_indices: torch.Tensor,
+        req_indices: torch.Tensor,
+        counter: torch.Tensor | None = None,
+    ) -> None:
+        """Deferred commit (VLLM_GDN_RECOVER_FOLD=1): before rows that do not
+        run the fold verify (prefill / non-spec rows) read their state, fold
+        the records pending in their request-table rows `req_indices[n]` into
+        `slot_indices[n]` and clear them. A no-op for rows with nothing
+        pending. counter (int64[2], optional): += (rows folded, records)."""
+        assert self.defer is not None
+        N = slot_indices.shape[0]
+        if N == 0:
+            return
+        plan = self._plan_buffer(N)
+        _gdn_recover_defer_flush_plan_kernel[(N,)](
+            slot_indices.contiguous(),
+            req_indices.contiguous(),
+            self.defer.half,
+            self.defer.pending,
+            plan,
+            counter,
+            HALF=self.records[0].half,
+            num_warps=1,
+        )
+        self._launch_commit(plan, N)
+
     def commit(
         self,
         slot_indices: torch.Tensor,
