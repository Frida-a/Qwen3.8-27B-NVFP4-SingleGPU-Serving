+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""VLLM_GDN_SPEC_STATE=recover with the int16 row-scaled state
+(--mamba-ssm-cache-dtype int16): verify + commit through the int16 codec must
+reproduce the per-token Triton path (also int16) bit-exactly -- outputs and
+the stored int16 codes/scales of the accepted state -- step after step.
+
+W = 1 only: the per-token path re-quantizes the state every step, which the
+recover commit does too (W > 1 re-quantizes only on fold, so it differs).
+"""
+
+import os
+
+import pytest
+import torch
+
+from vllm.model_executor.layers.mamba.ops.gdn_recover_spec import (
+    GDNRecoverCommitGroup,
+    GDNRecoverRecords,
+    gdn_recover_verify,
+)
+from vllm.model_executor.layers.mamba.ops.gdn_state_int16 import (
+    gdn_int16_state_rows,
+    quantize_state_int16_ref,
+)
+from vllm.third_party.flash_linear_attention.ops.fused_sigmoid_gating import (
+    fused_sigmoid_gating_delta_rule_update,
+)
+
+INTERPRET = os.environ.get("TRITON_INTERPRET") == "1"
+DEV = "cpu" if INTERPRET else "cuda"
+if not INTERPRET and not torch.cuda.is_available():
+    pytest.skip("CUDA only", allow_module_level=True)
+
+K = V = 128
+H = 16 if not INTERPRET else 2
+HV = 48 if not INTERPRET else 6
+VP = gdn_int16_state_rows(V, K)
+
+
+def _bits(x):
+    return x.view({4: torch.int32, 2: torch.int16}[x.element_size()])
+
+
+def _same(got, ref, what):
+    assert got.shape == ref.shape and got.dtype == ref.dtype, what
+    if ref.is_floating_point():
+        assert torch.isfinite(ref.float()).all(), f"{what}: non-finite reference"
+    n_bad = int((_bits(got) != _bits(ref)).sum())
+    assert n_bad == 0, f"{what}: {n_bad}/{got.numel()} elements differ"
+
+
+def _inputs(qlens, gen):
+    T = sum(qlens)
+    conv_dim = 2 * H * K + HV * V
+    qkv = (torch.randn((T, conv_dim), generator=gen, device=DEV) * 0.5).to(
+        torch.bfloat16
+    )
+    qkv[:, 2 * H * K :] *= 4
+    ba = torch.randn((T, 2 * HV), generator=gen, device=DEV).to(torch.bfloat16)
+    cu = torch.zeros(len(qlens) + 1, dtype=torch.int32, device=DEV)
+    cu[1:] = torch.cumsum(torch.tensor(qlens, device=DEV), 0)
+    q = qkv[:, : H * K].view(T, H, K)
+    k = qkv[:, H * K : 2 * H * K].view(T, H, K)
+    v = qkv[:, 2 * H * K :].view(T, HV, V)
+    return q, k, v, ba[:, HV:], ba[:, :HV], cu
+
+
+@pytest.mark.parametrize("by_row", [True, False])
+@pytest.mark.parametrize("N,t_max", [(1, 4), (3, 4), (4, 8)])
+def test_int16_recover_matches_per_token(N, t_max, by_row):
+    if not INTERPRET and N == 1:
+        N = 32  # also a larger batch on GPU
+    steps = 4
+    gen = torch.Generator(device=DEV).manual_seed(N * 10 + t_max + by_row)
+    cpu_gen = torch.Generator().manual_seed(N + t_max)
+    A_log = torch.log(torch.rand(HV, generator=gen, device=DEV) * 15 + 1)
+    dt_bias = torch.randn(HV, generator=gen, device=DEV)
+    s0 = torch.randn((N, HV, V, K), generator=gen, device=DEV)
+    s0[:, :, ::7] *= 30.0  # heavy-tailed rows
+    init = quantize_state_int16_ref(s0)
+
+    # Per-token path: N x t_max slots per step; the accepted column feeds the
+    # next step (num_accepted_tokens), as in the model runner (mode "none").
+    pool = torch.zeros((1 + N * t_max, HV, VP, K), dtype=torch.int16, device=DEV)
+    idx = torch.arange(1, 1 + N * t_max, device=DEV, dtype=torch.int32).view(N, t_max)
+    pool[idx[:, 0].long()] = init
+    acc_prev = torch.ones(N, dtype=torch.int32, device=DEV)
+    # Recover: one slot per request.
+    state = torch.zeros((1 + N, HV, VP, K), dtype=torch.int16, device=DEV)
+    slots = torch.arange(1, N + 1, dtype=torch.int32, device=DEV)
+    state[1:] = init
+    rec = GDNRecoverRecords.allocate(
+        N if by_row else 1 + N, H, HV, K, V, t_max - 1, torch.bfloat16, DEV,
+        by_row=by_row,
+    )  # fmt: skip
+    group = GDNRecoverCommitGroup([state], [rec], num_k_heads=H)
+    assert group.fmt == "int16_row"
+
+    for s in range(steps):
+        qlens = torch.randint(1, t_max + 1, (N,), generator=cpu_gen).tolist()
+        q, k, v, a, b, cu = _inputs(qlens, gen)
+        o_ref, _ = fused_sigmoid_gating_delta_rule_update(
+            A_log=A_log, a=a.contiguous().unsqueeze(0), b=b.contiguous().unsqueeze(0),
+            dt_bias=dt_bias, q=q.contiguous().unsqueeze(0),
+            k=k.contiguous().unsqueeze(0), v=v.contiguous().unsqueeze(0),
+            initial_state=pool, inplace_final_state=True, cu_seqlens=cu,
+            ssm_state_indices=idx, num_accepted_tokens=acc_prev,
+            use_qk_l2norm_in_kernel=True,
+        )  # fmt: skip
+        out = torch.empty((sum(qlens), HV, V), dtype=torch.bfloat16, device=DEV)
+        gdn_recover_verify(
+            q, k, v, a, b, A_log, dt_bias, state, rec, cu, slots, out=out
+        )
+        _same(out, o_ref.squeeze(0), f"output step {s}")
+        acc = torch.tensor(
+            [int(torch.randint(1, ql + 1, (1,), generator=cpu_gen)) for ql in qlens],
+            dtype=torch.int32,
+            device=DEV,
+        )
+        group.commit(slots, cu, acc)
+        ref_state = pool[idx[torch.arange(N), acc.long() - 1].long()]
+        _same(state[1:], ref_state, f"int16 state step {s}")
+        acc_prev = acc
+
+
+def test_int16_align_boundary():
+    """Align mode: the boundary block gets the int16 encoding of the state at
+    the boundary, exactly as the per-token path's column."""
+    bs, t_max, cols, N = 8, 4, 4, 2
+    computed, acc = [5, 13], [4, 3]
+    gen = torch.Generator(device=DEV).manual_seed(5)
+    q, k, v, a, b, cu = _inputs([t_max] * N, gen)
+    A_log = torch.log(torch.rand(HV, generator=gen, device=DEV) * 15 + 1)
+    dt_bias = torch.randn(HV, generator=gen, device=DEV)
+    init = quantize_state_int16_ref(
+        torch.randn((N, HV, V, K), generator=gen, device=DEV)
+    )
+    pool = torch.zeros((1 + N * t_max, HV, VP, K), dtype=torch.int16, device=DEV)
+    idx = torch.arange(1, 1 + N * t_max, device=DEV, dtype=torch.int32).view(N, t_max)
+    pool[idx[:, 0].long()] = init
+    fused_sigmoid_gating_delta_rule_update(
+        A_log=A_log, a=a.contiguous().unsqueeze(0), b=b.contiguous().unsqueeze(0),
+        dt_bias=dt_bias, q=q.contiguous().unsqueeze(0), k=k.contiguous().unsqueeze(0),
+        v=v.contiguous().unsqueeze(0), initial_state=pool, inplace_final_state=True,
+        cu_seqlens=cu, ssm_state_indices=idx,
+        num_accepted_tokens=torch.ones(N, dtype=torch.int32, device=DEV),
+        use_qk_l2norm_in_kernel=True,
+    )  # fmt: skip
+    table = (1 + torch.arange(N * cols, dtype=torch.int32, device=DEV)).view(N, cols)
+    run_col = [(c + t_max - 1) // bs for c in computed]
+    slots = table[torch.arange(N), torch.tensor(run_col)].contiguous()
+    state = torch.zeros((1 + N * cols, HV, VP, K), dtype=torch.int16, device=DEV)
+    state[slots.long()] = init
+    rec = GDNRecoverRecords.allocate(
+        N, H, HV, K, V, t_max - 1, torch.bfloat16, DEV, by_row=True
+    )
+    gdn_recover_verify(q, k, v, a, b, A_log, dt_bias, state, rec, cu, slots)
+    GDNRecoverCommitGroup([state], [rec], num_k_heads=H).commit(
+        slots,
+        cu,
+        torch.tensor(acc, dtype=torch.int32, device=DEV),
+        block_table=table,
+        num_computed_tokens=torch.tensor(computed, dtype=torch.int32, device=DEV),
+        mamba_block_size=bs,
+    )
+    for n in range(N):
+        _same(state[slots[n]], pool[idx[n, acc[n] - 1]], f"final row {n}")
+        nb = (computed[n] // bs + 1) * bs
+        if nb - computed[n] <= acc[n] and nb // bs - 1 != run_col[n]:
+            _same(
+                state[table[n, nb // bs - 1]],
+                pool[idx[n, nb - computed[n] - 1]],
+                f"boundary row {n}",
+            )
