+    # Values: NVFP4 per 16 elements (emulation-exact rounding); byte j packs
+    # elements j (low nibble) and j + D/2 (high nibble).
+    HALF: tl.constexpr = HEAD_DIM // 2
+    dh = tl.arange(0, HALF)
+    vrow = value_ptr + t * stride_vt + h * stride_vh
+    v_lo = tl.math.div_rn(tl.load(vrow + dh).to(tl.float32), vg)
+    v_hi = tl.math.div_rn(tl.load(vrow + HALF + dh).to(tl.float32), vg)
+    c_lo, s_lo = _quant_nvfp4_half(v_lo, HALF)
+    c_hi, s_hi = _quant_nvfp4_half(v_hi, HALF)
+    packed = (c_lo | (c_hi << 4)).to(tl.uint8)
+    tl.store(vd_ptr + page_base + row * HALF + dh, packed)
+    ds = tl.arange(0, HALF // 16)
+    srow = vs_ptr + page_base + row * (HEAD_DIM // 16)
+    tl.store(srow + ds, s_lo.to(tl.uint8, bitcast=True))
+    tl.store(srow + HALF // 16 + ds, s_hi.to(tl.uint8, bitcast=True))
 
 
