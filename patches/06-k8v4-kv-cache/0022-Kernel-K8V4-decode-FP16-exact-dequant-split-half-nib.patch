 @triton.jit
-def _dequant_v_tile(vd, vsc, g, HEAD_DIM: tl.constexpr, ROWS: tl.constexpr):
-    """[ROWS, D/2] packed codes (int32) + [ROWS, D/16] fp32 scales -> [ROWS, D]
-    fp32 values `(e2m1 * bs) * g`."""
-    lo = _e2m1_to_f32(vd & 15)
-    hi = _e2m1_to_f32((vd >> 4) & 15)
-    sc = tl.reshape(
-        tl.broadcast_to(vsc[:, :, None], [ROWS, HEAD_DIM // 16, 8]),
-        [ROWS, HEAD_DIM // 2],
-    )
-    lo = (lo * sc) * g
-    hi = (hi * sc) * g
-    return tl.reshape(tl.join(lo, hi), [ROWS, HEAD_DIM])
+def _e2m1_f16_scaled(c):
+    """E2M1 code (int32, 0..15) -> fp16 equal to value * 2^-14 (exact)."""
+    bits = ((c & 8) << 12) | ((c & 7) << 9)
+    return bits.to(tl.int16).to(tl.float16, bitcast=True)
+
+
+@triton.jit
+def _quant_nvfp4_half(b, HALF: tl.constexpr):
+    """[HALF] fp32 (already / g) -> (codes int32 [HALF], fp8 block scales [HALF/16])."""
+    b2 = tl.reshape(b, [HALF // 16, 16])
+    amax = tl.max(tl.abs(b2), axis=1)
+    bs = tl.minimum(tl.math.div_rn(amax, 6.0), 448.0).to(tl.float8e4nv)
+    bsf = bs.to(tl.float32)
+    safe = tl.where(bsf == 0.0, 1.0, bsf)
+    y = tl.clamp(tl.math.div_rn(b2, safe[:, None]), -6.0, 6.0)
+    a = tl.abs(y)
+    code = tl.where(
+        a < 2.0,
+        tldevice.rint(a * 2.0),
+        tl.where(a < 4.0, tldevice.rint(a) + 2.0, tl.where(a < 5.0, 6.0, 7.0)),
+    ).to(tl.int32)
+    code = code | tl.where(y < 0.0, 8, 0)
+    return tl.reshape(code, [HALF]), bs
 
 
