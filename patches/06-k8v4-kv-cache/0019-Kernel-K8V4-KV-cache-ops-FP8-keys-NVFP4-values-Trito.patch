+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""K8V4 KV cache kernels (FP8 keys, NVFP4 values): writer vs the QW38 emulation
+quantizers (bitwise), decode / multi-token verify vs an FP32 reference on the
+emulated K/V, CUDA-graph replay == eager, prefill page gather."""
+
+import math
+
+import pytest
+import torch
+
+from vllm.v1.attention.ops.k8v4_kv import (
+    FP8_DTYPE,
+    k8v4_decode,
+    k8v4_gather_pages,
+    k8v4_head_bytes,
+    k8v4_mock_paged,
+    k8v4_read_cache_ref,
+    k8v4_store,
+    qdq_fp8_ref,
+    qdq_nvfp4_ref,
+)
+
+if not torch.cuda.is_available():
+    pytest.skip("CUDA required", allow_module_level=True)
+
+DEV = "cuda"
+D = 256
+HKV = 4
+GROUP = 6
+
+
+def _make_cache(num_blocks, page, hkv=HKV, d=D):
+    c = torch.randint(0, 256, (num_blocks, hkv, page, k8v4_head_bytes(d)),
+                      dtype=torch.uint8, device=DEV)
+    return c
+
+
+def _kv(t, hkv=HKV, d=D, seed=0):
+    g = torch.Generator(device=DEV).manual_seed(seed)
+    k = torch.randn(t, hkv, d, generator=g, device=DEV) * 2.0
+    v = torch.randn(t, hkv, d, generator=g, device=DEV)
+    # heavy-tailed channels, zero blocks, exact ties and huge values
+    v[:, :, 5] *= 40.0
+    v[::7, :, 16:32] = 0.0
+    if t > 3:
+        v[3, 0, 32:48] = torch.tensor([6, 5, 0.25, 0.75, 1.25, 1.75, 2.5, 3.5, 4.5,
+                                       -5, -0.25, -2.5, 3, 1, 0.5, 0], device=DEV)
+        v[2, 1, 48:64] = 3000.0
+        k[2, 1, :8] = 600.0
+    return k.to(torch.bfloat16), v.to(torch.bfloat16)
+
+
+@pytest.mark.parametrize("page", [16, 64])
+@pytest.mark.parametrize("scales", [(1.0, 1.0), (0.75, 0.37)])
+def test_store_matches_emulation(page, scales):
+    ks, vg = scales
+    t = 300
+    k, v = _kv(t)
+    nb = 2 + (t + page - 1) // page * 2
+    cache = _make_cache(nb, page)
+    slots = torch.randperm((nb - 1) * page, device=DEV)[:t] + page  # skip block 0
+    slots[5] = -1
+    k8v4_store(k, v, cache, slots, torch.tensor(ks, device=DEV),
+               torch.tensor(vg, device=DEV))
+    kf, vf = k8v4_read_cache_ref(cache, D, v_scale=vg, k_scale=ks)
+    ok = slots >= 0
+    sl = slots[ok]
+    blk, off = sl // page, sl % page
+    got_k = kf[blk, :, off]  # [n, H, D]
+    got_v = vf[blk, :, off]
+    exp_k = qdq_fp8_ref(k[ok].reshape(-1, HKV * D), ks).view(-1, HKV, D)
+    exp_v = qdq_nvfp4_ref(v[ok].reshape(-1, HKV * D), vg).view(-1, HKV, D)
+    assert torch.equal(got_k, exp_k)
+    assert torch.equal(got_v, exp_v), (got_v - exp_v).abs().max()
+    # skipped slot untouched: the slot mapped to token 5 is -1, nothing to check;
+    # bitwise equality above already covers every written slot.
+
+
+def _ref_attention(q, kf, vf, block_tables, seq_lens, q_starts, q_lens, scale):
+    """FP32 reference on decoded K/V; returns [T, Hq, D]."""
+    out = torch.zeros(q.shape, dtype=torch.float32, device=DEV)
+    page = kf.shape[2]
+    for b in range(block_tables.shape[0]):
+        s, ql, q0 = int(seq_lens[b]), int(q_lens[b]), int(q_starts[b])
+        if s == 0 or ql == 0:
+            continue
+        npg = (s + page - 1) // page
+        ids = block_tables[b, :npg].long()
+        kk = kf[ids].permute(1, 0, 2, 3).reshape(HKV, -1, D)[:, :s].float()
+        vv = vf[ids].permute(1, 0, 2, 3).reshape(HKV, -1, D)[:, :s].float()
+        qq = q[q0:q0 + ql].float().view(ql, HKV, GROUP, D)
+        sc = torch.einsum("thgd,hnd->thgn", qq, kk) * scale
+        pos = torch.arange(s, device=DEV)
+        qpos = s - ql + torch.arange(ql, device=DEV)
+        mask = pos[None, :] <= qpos[:, None]
+        sc = sc.masked_fill(~mask[:, None, None, :], float("-inf"))
+        p = torch.softmax(sc, dim=-1)
+        o = torch.einsum("thgn,hnd->thgd", p, vv)
+        out[q0:q0 + ql] = o.reshape(ql, HKV * GROUP, D)
+    return out
+
+
+def _setup_decode(seq_lens_list, q_lens_list, page, seed=1):
+    torch.manual_seed(seed)
+    nreq = len(seq_lens_list)
+    max_pages = max((s + page - 1) // page for s in seq_lens_list) + 1
+    nb = nreq * max_pages + 4
+    cache = _make_cache(nb, page)
+    perm = torch.randperm(nb - 1, device=DEV) + 1
+    bt = perm[: nreq * max_pages].view(nreq, max_pages).to(torch.int32).contiguous()
+    for b, s in enumerate(seq_lens_list):
+        if s == 0:
+            continue
+        k, v = _kv(s, seed=seed + b)
+        pos = torch.arange(s, device=DEV)
+        slots = bt[b, pos // page].long() * page + pos % page
+        k8v4_store(k, v, cache, slots, torch.tensor(1.0, device=DEV),
+                   torch.tensor(1.0, device=DEV))
+    seq_lens = torch.tensor(seq_lens_list, dtype=torch.int32, device=DEV)
+    q_lens = torch.tensor(q_lens_list, dtype=torch.int32, device=DEV)
+    q_cu = torch.zeros(nreq + 1, dtype=torch.int32, device=DEV)
+    q_cu[1:] = torch.cumsum(q_lens, 0)
+    t = int(q_cu[-1])
+    q = (torch.randn(t, HKV * GROUP, D, device=DEV) * 2).to(torch.bfloat16)
+    return cache, bt, seq_lens, q_lens, q_cu, q
+
+
+def _check(out, ref):
+    err = (out.float() - ref).abs().max().item()
+    rel = ((out.float() - ref).norm() / ref.norm().clamp_min(1e-6)).item()
+    assert err < 3e-2 and rel < 6e-3, (err, rel)
+
+
+@pytest.mark.parametrize("page", [16, 64])
+@pytest.mark.parametrize("qlen", [1, 4, 8])
+@pytest.mark.parametrize("splits", [1, 3, None])
+def test_decode_uniform(page, qlen, splits):
+    seqs = [qlen, 63 + qlen, 64, 1000, 5003, 0]
+    seqs = [max(s, qlen) if s else 0 for s in seqs]
+    qls = [qlen if s else 0 for s in seqs]
+    # uniform: padded request (seq 0) still owns qlen rows
+    qls_u = [qlen] * len(seqs)
+    cache, bt, sl, _, _, _ = _setup_decode(seqs, qls_u, page)
+    t = qlen * len(seqs)
+    q = (torch.randn(t, HKV * GROUP, D, device=DEV) * 2).to(torch.bfloat16)
+    out = torch.empty_like(q)
+    scale = 1.0 / math.sqrt(D)
+    k8v4_decode(q, cache, bt, sl, out, scale, q_len_per_req=qlen, num_splits=splits)
+    kf, vf = k8v4_read_cache_ref(cache, D)
+    starts = torch.arange(len(seqs)) * qlen
+    ref = _ref_attention(q, kf, vf, bt, sl, starts, torch.tensor(qls), scale)
+    real = torch.tensor([s > 0 for s in seqs]).repeat_interleave(qlen).to(DEV)
+    _check(out[real], ref[real])
+    assert torch.all(out[~real] == 0)
+
+
+@pytest.mark.parametrize("splits", [1, 4])
+def test_decode_ragged(splits):
+    seqs = [5, 200, 4096, 77]
+    qls = [1, 4, 3, 2]
+    cache, bt, sl, ql, qcu, q = _setup_decode(seqs, qls, 64)
+    out = torch.empty_like(q)
+    scale = 1.0 / math.sqrt(D)
+    k8v4_decode(q, cache, bt, sl, out, scale, q_len_per_req=4, q_cu_seq_lens=qcu,
+                num_splits=splits)
+    kf, vf = k8v4_read_cache_ref(cache, D)
+    ref = _ref_attention(q, kf, vf, bt, sl, qcu[:-1], ql, scale)
+    _check(out, ref)
+
+
+def test_decode_matches_emulated_bf16_cache():
+    """The kernel on a K8V4 cache == the same kernel math on the emulation's
+    BF16 values: compare against SDPA in BF16 on qdq'd K/V."""
+    seqs, qls = [3000], [4]
+    cache, bt, sl, ql, qcu, q = _setup_decode(seqs, qls, 64, seed=7)
+    out = torch.empty_like(q)
+    scale = 1.0 / math.sqrt(D)
+    k8v4_decode(q, cache, bt, sl, out, scale, q_len_per_req=4)
+    k, v = _kv(3000, seed=7)
+    ke = qdq_fp8_ref(k.reshape(3000, -1), 1.0).view(3000, HKV, D)
+    ve = qdq_nvfp4_ref(v.reshape(3000, -1), 1.0).view(3000, HKV, D)
+    qq = q.view(4, HKV * GROUP, D).transpose(0, 1)  # [Hq, 4, D]
+    kk = ke.transpose(0, 1).repeat_interleave(GROUP, 0)
+    vv = ve.transpose(0, 1).repeat_interleave(GROUP, 0)
+    mask = torch.arange(3000, device=DEV)[None] <= (3000 - 4 + torch.arange(4, device=DEV))[:, None]
+    ref = torch.nn.functional.scaled_dot_product_attention(
+        qq, kk, vv, attn_mask=mask, scale=scale).transpose(0, 1)
+    err = (out.float() - ref.float()).abs().max().item()
+    assert err < 3e-2, err
+
+
+def test_decode_cuda_graph_replay():
+    seqs, qls = [700, 3000, 64, 9], [4, 4, 4, 4]
+    cache, bt, sl, ql, qcu, q = _setup_decode(seqs, qls, 64, seed=3)
+    scale = 1.0 / math.sqrt(D)
+    out = torch.empty_like(q)
+    sl_g, bt_g, q_g = sl.clone(), bt.clone(), q.clone()
+    k8v4_decode(q_g, cache, bt_g, sl_g, out, scale, q_len_per_req=4)  # warm/compile
+    g = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g):
+        k8v4_decode(q_g, cache, bt_g, sl_g, out, scale, q_len_per_req=4)
+    for step in range(3):
+        sl_g.copy_((sl - step * 7).clamp_min(4))
+        q_g.copy_((torch.randn_like(q.float()) * 2).to(q.dtype))
+        g.replay()
+        torch.cuda.synchronize()
+        eager = torch.empty_like(q)
+        k8v4_decode(q_g, cache, bt_g, sl_g, eager, scale, q_len_per_req=4)
+        assert torch.equal(out, eager)
+
+
+@pytest.mark.parametrize("page", [16, 64])
+def test_gather_pages(page):
+    cache = _make_cache(40, page)
+    # valid caches only: write real data so scales are finite
+    k, v = _kv(40 * page, seed=11)
+    slots = torch.arange(40 * page, device=DEV)
+    k8v4_store(k, v, cache, slots, torch.tensor(1.0, device=DEV),
+               torch.tensor(1.0, device=DEV))
+    ids = torch.tensor([7, 3, 39, 1, 3], dtype=torch.int32, device=DEV)
+    kf, vf = k8v4_read_cache_ref(cache, D)
+    gk, gv = k8v4_gather_pages(cache, ids, D, FP8_DTYPE)
+    assert torch.equal(gk.float().to(torch.bfloat16), kf[ids.long()])
+    exp_v = vf[ids.long()].float().clamp(-448, 448).to(FP8_DTYPE)
+    assert torch.equal(gv.view(torch.uint8), exp_v.view(torch.uint8))
+    bk, bv = k8v4_gather_pages(cache, ids, D, torch.bfloat16)
+    assert torch.equal(bk, kf[ids.long()]) and torch.equal(bv, vf[ids.long()])
+
+
+def test_mock_paged():
+    page = 64
+    cache = _make_cache(30, page)
+    k, v = _kv(30 * page, seed=5)
+    k8v4_store(k, v, cache, torch.arange(30 * page, device=DEV),
+               torch.tensor(1.0, device=DEV), torch.tensor(1.0, device=DEV))
+    bt = torch.tensor([[4, 9, 2, 0], [11, 0, 0, 0]], dtype=torch.int32, device=DEV)
+    sl = torch.tensor([150, 10], dtype=torch.int32, device=DEV)
+    mock, mbt = k8v4_mock_paged(cache, bt, sl, 150, D)
+    assert mbt.shape == (2, 3)
+    kf, vf = k8v4_read_cache_ref(cache, D)
+    for b, npg in ((0, 3), (1, 1)):
+        for j in range(npg):
+            src = int(bt[b, j])
+            dst = int(mbt[b, j])
+            assert torch.equal(mock[dst, 0].float().to(torch.bfloat16), kf[src])
+            exp_v = vf[src].float().clamp(-448, 448).to(FP8_DTYPE)
+            assert torch.equal(mock[dst, 1].view(torch.uint8), exp_v.view(torch.uint8))
