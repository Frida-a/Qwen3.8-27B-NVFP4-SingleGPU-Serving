+++ b/vllm/config/cache.py
@@ -64,6 +64,7 @@ CacheDType = Literal[
     "fp8_per_token_head",
     "nvfp4",
     "nvfp4_4over6",
+    "k8v4",
 ]
 
 # Mutable mirror of the CacheDType Literal. Custom dtypes registered by
@@ -247,6 +248,9 @@ class CacheConfig:
     to fp8.
     "nvfp4_4over6" uses the NVFP4 layout and selects between max/6 and max/4
     scales per 16 values by minimizing squared reconstruction error.
+    "k8v4" stores FP8 E4M3 keys and NVFP4 values (E2M1 + E4M3 block scales per
+    16 + the layer's v_scale as global scale); FlashInfer backend, SM100/SM120,
+    HND layout (vllm/v1/attention/ops/k8v4_kv.py).
     """
     is_attention_free: bool = False
     """Whether the model is attention-free. This is primarily set in
diff --git a/vllm/utils/torch_utils.py b/vllm/utils/torch_utils.py
