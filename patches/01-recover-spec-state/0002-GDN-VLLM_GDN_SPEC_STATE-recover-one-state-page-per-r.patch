+++ b/tests/kernels/mamba/test_gdn_recover_model_path.py
@@ -0,0 +1,209 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Model path of VLLM_GDN_SPEC_STATE=recover vs the per-token Triton path.
+
+Runs QwenGatedDeltaNetAttention._forward_core with real GDN metadata for
+several speculative steps in both modes, committing the recover mode's
+records after each step as the model runner does. Outputs, convolution
+states and accepted recurrent states must be bit-identical.
+"""
+
+import os
+import types
+from unittest.mock import patch
+
+import pytest
+import torch
+
+from vllm.platforms import current_platform
+
+if not current_platform.is_cuda():
+    pytest.skip("CUDA only", allow_module_level=True)
+
+from tests.v1.attention.utils import (  # noqa: E402
+    BatchSpec,
+    create_common_attn_metadata,
+    create_vllm_config,
+)
+from vllm.config import SpeculativeConfig, set_current_vllm_config  # noqa: E402
+from vllm.model_executor.layers.mamba.gdn import qwen_gdn_linear_attn  # noqa: E402
+from vllm.model_executor.layers.mamba.gdn.qwen_gdn_linear_attn import (  # noqa: E402
+    QwenGatedDeltaNetAttention,
+)
+from vllm.model_executor.layers.mamba.mamba_utils import (  # noqa: E402
+    MambaStateShapeCalculator,
+)
+from vllm.v1.attention.backends.gdn_attn import (  # noqa: E402
+    GDNAttentionMetadataBuilder,
+    GDNRecoverSpecMetadata,
+)
+from vllm.v1.kv_cache_interface import MambaSpec  # noqa: E402
+
+NUM_SPEC = 3
+T = NUM_SPEC + 1
+H, HV, K, V = 2, 6, 128, 128
+CONV_KERNEL = 4
+CONV_DIM = 2 * H * K + HV * V
+BLOCK_SIZE = 16
+PREFIX = "model.layers.0.linear_attn"
+# Any Qwen3.5-family config works; override with a local path when offline.
+MODEL = os.environ.get("GDN_RECOVER_TEST_MODEL", "Qwen/Qwen3.5-0.8B")
+
+
+def _bits(x):
+    return x.view({4: torch.int32, 2: torch.int16}[x.element_size()])
+
+
+def _make_vllm_config():
+    config = create_vllm_config(
+        model_name=MODEL,
+        block_size=BLOCK_SIZE,
+        hf_config_override={"linear_key_head_dim": K},
+    )
+    config.additional_config = {"gdn_prefill_backend": "triton"}
+    config.cache_config.mamba_cache_mode = "none"
+    config.speculative_config = SpeculativeConfig(
+        method="ngram", num_speculative_tokens=NUM_SPEC
+    )
+    return config
+
+
+def _layer(vllm_config, kv_cache, params, recover):
+    a_log, dt_bias, conv_weight = params
+    layer = types.SimpleNamespace(
+        prefix=PREFIX,
+        enable_packed_recurrent_decode=False,
+        tp_size=1,
+        num_k_heads=H,
+        num_v_heads=HV,
+        head_k_dim=K,
+        head_v_dim=V,
+        key_dim=H * K,
+        value_dim=HV * V,
+        activation="silu",
+        A_log=a_log,
+        dt_bias=dt_bias,
+        conv1d=types.SimpleNamespace(weight=conv_weight, bias=None),
+        kv_cache=kv_cache,
+        num_spec=NUM_SPEC,
+        spec_recover=recover,
+        gdn_decode_kernel="triton",
+    )
+    for name in ("rearrange_mixed_qkv", "_forward_core", "_recover_spec_verify"):
+        setattr(
+            layer,
+            name,
+            types.MethodType(getattr(QwenGatedDeltaNetAttention, name), layer),
+        )
+    return layer
+
+
+@pytest.mark.parametrize("num_reqs", [1, 5])
+@torch.inference_mode()
+def test_recover_matches_per_token_path(monkeypatch, num_reqs):
+    torch.manual_seed(0)
+    dev = torch.device("cuda")
+    steps = 5
+    gen = torch.Generator().manual_seed(num_reqs)
+    conv_shape, ssm_shape = MambaStateShapeCalculator.gated_delta_net_state_shape(
+        1, H, HV, K, V, CONV_KERNEL, NUM_SPEC
+    )[:2]
+    conv0 = 0.05 * torch.randn(num_reqs, *conv_shape, device=dev).to(torch.bfloat16)
+    ssm0 = 0.05 * torch.randn(num_reqs, *ssm_shape, device=dev)
+    params = (
+        torch.log(torch.rand(HV, device=dev) * 15 + 1),
+        0.1 * torch.randn(HV, device=dev),
+        0.3 * torch.randn(CONV_DIM, 1, CONV_KERNEL, device=dev).to(torch.bfloat16),
+    )
+    inputs = [
+        (
+            torch.randn(num_reqs * T, CONV_DIM, device=dev).to(torch.bfloat16),
+            torch.randn(num_reqs * T, 2 * HV, device=dev).to(torch.bfloat16),
+        )
+        for _ in range(steps)
+    ]
+    accepted = torch.randint(1, T + 1, (steps, num_reqs), generator=gen).to(torch.int32)
+
+    results = {}
+    for recover in (False, True):
+        monkeypatch.setenv("VLLM_GDN_SPEC_STATE", "recover" if recover else "per_token")
+        vllm_config = _make_vllm_config()
+        cols = 1 if recover else T
+        builder = GDNAttentionMetadataBuilder(
+            kv_cache_spec=MambaSpec(
+                block_size=BLOCK_SIZE,
+                shapes=((16, 64),),
+                dtypes=(torch.float16,),
+                num_speculative_blocks=cols - 1,
+            ),
+            layer_names=[PREFIX],
+            vllm_config=vllm_config,
+            device=dev,
+        )
+        assert builder.spec_recover == recover
+        num_slots = 1 + num_reqs * cols
+        table = 1 + torch.arange(num_reqs * cols, device=dev, dtype=torch.int32)
+        table = table.view(num_reqs, cols)
+        conv = torch.zeros(num_slots, *conv_shape, device=dev, dtype=torch.bfloat16)
+        ssm = torch.zeros(num_slots, *ssm_shape, device=dev)
+        conv[table[:, 0].long()] = conv0
+        ssm[table[:, 0].long()] = ssm0
+        kv_cache = (conv, ssm)
+        if recover:
+            shapes = MambaStateShapeCalculator.gated_delta_net_state_shape(
+                1, H, HV, K, V, CONV_KERNEL, NUM_SPEC
+            )
+            assert len(shapes) == 5
+            kv_cache += (
+                torch.zeros(num_slots, *shapes[2], device=dev),
+                torch.zeros(num_slots, *shapes[3], device=dev, dtype=torch.bfloat16),
+                torch.zeros(num_slots, *shapes[4], device=dev),
+            )
+        layer = _layer(vllm_config, kv_cache, params, recover)
+        vllm_config.compilation_config.static_forward_context[PREFIX] = layer
+        outs = []
+        prev_acc = torch.ones(num_reqs, dtype=torch.int32, device=dev)
+        for s in range(steps):
+            batch = BatchSpec(
+                seq_lens=[64 + T * (s + 1)] * num_reqs, query_lens=[T] * num_reqs
+            )
+            common = create_common_attn_metadata(batch, BLOCK_SIZE, dev)
+            common = common.replace(block_table_tensor=table)
+            with set_current_vllm_config(vllm_config):
+                meta = builder.build(
+                    common_prefix_len=0,
+                    common_attn_metadata=common,
+                    num_accepted_tokens=prev_acc.clone(),
+                    num_decode_draft_tokens_cpu=torch.full(
+                        (num_reqs,), NUM_SPEC, dtype=torch.int32
+                    ),
+                )
+            assert isinstance(meta, GDNRecoverSpecMetadata) == recover
+            mixed_qkv, ba = inputs[s]
+            out = torch.zeros(num_reqs * T, HV, V, device=dev, dtype=torch.bfloat16)
+            context = types.SimpleNamespace(attn_metadata={PREFIX: meta})
+            with patch.object(
+                qwen_gdn_linear_attn, "get_forward_context", return_value=context
+            ):
+                layer._forward_core(
+                    mixed_qkv=mixed_qkv.clone(),
+                    b=ba[:, :HV],
+                    a=ba[:, HV:],
+                    core_attn_out=out,
+                )
+            outs.append(out)
+            acc = accepted[s].to(dev)
+            if recover:
+                meta.commit_recoverssm_state(acc)
+            prev_acc = acc
+        if recover:
+            final = ssm[table[:, 0].long()]
+        else:
+            final = ssm[table[torch.arange(num_reqs), prev_acc.long() - 1].long()]
+        results[recover] = (outs, conv[table[:, 0].long()].clone(), final.clone())
+
+    (o0, c0, s0), (o1, c1, s1) = results[False], results[True]
+    for s in range(steps):
+        assert torch.equal(_bits(o1[s]), _bits(o0[s])), f"output step {s}"
+    assert torch.equal(_bits(c1), _bits(c0)), "conv state"
+    assert torch.equal(_bits(s1), _bits(s0)), "accepted ssm state"
