             if reason is not None:
@@ -898,8 +916,28 @@ class QwenGatedDeltaNetAttention(GatedDeltaNetAttention):
     def get_prefill_checkpoint_alignment(self) -> int | None:
         return self._checkpoint_alignment
 
+    def _spec_recover_unsupported_reason(self, vllm_config: VllmConfig) -> str | None:
+        _, ssm_dtype = self.get_state_dtype()[:2]
+        if vllm_config.cache_config.mamba_cache_mode != "none":
+            return (
+                "prefix caching (mamba_cache_mode='align') is not supported yet; "
+                "pass --no-enable-prefix-caching"
+            )
