+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""GDN metadata under VLLM_GDN_SPEC_STATE=recover: one state slot per
+request, and the commit after sampling gets the spec rows' slots, query
+boundaries and batch rows."""
+
+import pytest
+import torch
+
+from tests.v1.attention.test_gdn_metadata_builder import (
+    _build,
+    _create_gdn_builder,
+)
+from tests.v1.attention.utils import BatchSpec, create_common_attn_metadata
+from vllm.v1.attention.backends.gdn_attn import (
+    GDNAttentionMetadata,
+    GDNRecoverSpecMetadata,
+)
+
+BLOCK_SIZE = 16
+DEVICE = torch.device("cpu")
+NUM_SPEC = 3
+
+
+@pytest.fixture
+def recover_env(monkeypatch):
+    monkeypatch.setenv("VLLM_GDN_SPEC_STATE", "recover")
+
+
+class _FakeGroup:
+    def __init__(self):
+        self.calls = []
+
+    def commit(self, slots, cu, num_accepted, row_indices=None):
+        self.calls.append((slots.clone(), cu.clone(), num_accepted, row_indices))
+
+
+@pytest.mark.parametrize("full_cuda_graph", [False, True])
+def test_pure_spec_batch(recover_env, full_cuda_graph):
+    builder = _create_gdn_builder(NUM_SPEC, full_cuda_graph)
+    assert builder.spec_recover
+    batch = BatchSpec(seq_lens=[80, 96, 40], query_lens=[4, 2, 4])
+    common = create_common_attn_metadata(batch, BLOCK_SIZE, DEVICE)
+    meta = _build(builder, batch, [3, 1, 3], common.block_table_tensor)
+    assert isinstance(meta, GDNRecoverSpecMetadata)
+    assert meta.num_spec_decodes == 3
+    assert meta.spec_state_indices_tensor.shape[1] == 1
+    torch.testing.assert_close(
+        meta.recover_slot_indices, common.block_table_tensor[:3, 0]
+    )
+    assert meta.recover_row_indices is None
+    assert meta.recover_builder is builder
+
+    fake = _FakeGroup()
+    builder.recover_commit_group = lambda: fake
+    num_sampled = torch.tensor([2, 1, 4], dtype=torch.int32)
+    assert meta.commit_recoverssm_state(num_sampled) is None
+    (slots, cu, acc, rows), *rest = fake.calls
+    assert not rest
+    torch.testing.assert_close(slots, common.block_table_tensor[:3, 0])
+    torch.testing.assert_close(cu, torch.tensor([0, 4, 6, 10], dtype=cu.dtype))
+    assert acc is num_sampled and rows is None
+
+
+def test_mixed_batch_maps_spec_rows(recover_env):
+    builder = _create_gdn_builder(NUM_SPEC)
+    batch = BatchSpec(seq_lens=[100, 65, 20, 30], query_lens=[50, 1, 3, 4])
+    common = create_common_attn_metadata(batch, BLOCK_SIZE, DEVICE)
+    meta = _build(builder, batch, [-1, -1, 2, 3], common.block_table_tensor)
+    assert isinstance(meta, GDNRecoverSpecMetadata)
+    assert meta.num_spec_decodes == 2 and meta.num_prefills == 2
+    torch.testing.assert_close(
+        meta.recover_slot_indices, common.block_table_tensor[2:4, 0]
+    )
+    torch.testing.assert_close(
+        meta.recover_row_indices, torch.tensor([2, 3], dtype=torch.int32)
+    )
+    # Prefill rows read and write the same (single) slot column.
+    torch.testing.assert_close(
+        meta.prefill_state_indices, common.block_table_tensor[:2, 0]
+    )
+
+
+def test_no_spec_rows_commits_nothing(recover_env):
+    builder = _create_gdn_builder(NUM_SPEC)
+    batch = BatchSpec(seq_lens=[100, 65], query_lens=[50, 20])
+    meta = _build(builder, batch, [-1, -1])
+    assert isinstance(meta, GDNRecoverSpecMetadata)
+    assert meta.num_spec_decodes == 0 and meta.recover_slot_indices is None
+    builder.recover_commit_group = lambda: pytest.fail("no commit expected")
+    assert meta.commit_recoverssm_state(torch.ones(2, dtype=torch.int32)) is None
+
+
+@pytest.mark.parametrize("full_cuda_graph", [False, True])
+def test_update_block_table_uses_own_group(recover_env, full_cuda_graph):
+    src, dst = (_create_gdn_builder(NUM_SPEC, full_cuda_graph) for _ in range(2))
+    batch = BatchSpec(seq_lens=[80, 96], query_lens=[4, 4])
+    common = create_common_attn_metadata(batch, BLOCK_SIZE, DEVICE)
+    meta = _build(src, batch, [3, 3], common.block_table_tensor)
+    other_table = common.block_table_tensor + 100
+    meta2 = dst.update_block_table(meta, other_table, common.slot_mapping)
+    assert isinstance(meta2, GDNRecoverSpecMetadata)
+    assert meta2.recover_builder is dst and meta.recover_builder is src
+    torch.testing.assert_close(meta2.recover_slot_indices, other_table[:2, 0])
+    torch.testing.assert_close(
+        meta.recover_slot_indices, common.block_table_tensor[:2, 0]
+    )
+
+
+def test_default_mode_unchanged():
+    builder = _create_gdn_builder(NUM_SPEC)
+    assert not builder.spec_recover
+    batch = BatchSpec(seq_lens=[80, 96], query_lens=[4, 4])
+    meta = _build(builder, batch, [3, 3])
+    assert type(meta) is GDNAttentionMetadata
+    assert meta.spec_state_indices_tensor.shape[1] == NUM_SPEC + 1
