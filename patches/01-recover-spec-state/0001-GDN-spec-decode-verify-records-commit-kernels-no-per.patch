+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""GDN spec-decode verify: records + commit vs per-token state writes.
+
+Per layer (Qwen3.8-27B GDN, TP1: H=16, HV=48, K=V=128, fp32 state), every
+request verifying T = num_spec + 1 tokens:
+  triton  fused_sigmoid_gating_delta_rule_update, 2-D slots (T state writes)
+  cuda    fused_gdn_decode_post_conv_mtp (T state writes, gated RMSNorm fused)
+  b4      gdn_recover_verify + gated RMSNorm (separate) + commit
+          (commit timed per layer and amortized over a 16-layer group launch)
+Timings are CUDA-graph replays that rotate over disjoint state slots, so the
+states come from HBM (not L2) as in the 48-layer model.
+
+usage: python benchmarks/kernels/bench_gdn_recover_spec.py [--out res.json]
+"""
+
+import argparse
+import json
+
+import torch
+
+from vllm.model_executor.layers.mamba.ops.gdn_recover_spec import (
+    GDNRecoverCommitGroup,
+    GDNRecoverRecords,
+    gdn_recover_verify,
+)
+from vllm.third_party.flash_linear_attention.ops.fused_sigmoid_gating import (
+    fused_sigmoid_gating_delta_rule_update,
+)
+from vllm.third_party.flash_linear_attention.ops.layernorm_guard import (
+    layer_norm_fwd,
+)
+
+H, HV, K, V = 16, 48, 128, 128
+STATE_BYTES = HV * V * K * 4
+DEV = "cuda"
+MIN_ROTATION_BYTES = 768 << 20  # > L2
+
+
+def graph_time_us(fns, iters=20):
+    """Mean GPU time (us) of one fn call, replaying all fns in one graph."""
+    for f in fns:
+        f()
+    torch.cuda.synchronize()
+    g = torch.cuda.CUDAGraph()
+    s = torch.cuda.Stream()
+    with torch.cuda.stream(s), torch.cuda.graph(g):
+        for f in fns:
+            f()
+    torch.cuda.synchronize()
+    g.replay()
+    torch.cuda.synchronize()
+    start, end = torch.cuda.Event(True), torch.cuda.Event(True)
+    start.record()
+    for _ in range(iters):
+        g.replay()
+    end.record()
+    torch.cuda.synchronize()
+    return start.elapsed_time(end) * 1e3 / (iters * len(fns))
+
+
+def make_inputs(N, T, gen):
+    tok = N * T
+    conv_dim = 2 * H * K + HV * V
+    mixed_qkv = (torch.randn((tok, conv_dim), generator=gen, device=DEV) * 0.5).to(
+        torch.bfloat16
+    )
+    ba = torch.randn((tok, 2 * HV), generator=gen, device=DEV).to(torch.bfloat16)
+    gate = torch.randn((tok, HV, V), generator=gen, device=DEV).to(torch.bfloat16)
+    A_log = torch.log(torch.rand(HV, generator=gen, device=DEV) * 15 + 1)
+    dt_bias = torch.randn(HV, generator=gen, device=DEV)
+    cu = torch.arange(0, tok + 1, T, dtype=torch.int32, device=DEV)
+    return mixed_qkv, ba, gate, A_log, dt_bias, cu
+
+
+def bytes_model(N, T, n_acc):
+    """HBM bytes per layer per step (state + records; activations excluded)."""
+    rec_tok = HV * V * 4 + H * K * 2 + HV * 4  # u fp32, k bf16, g fp32
+    per_token = N * T * STATE_BYTES
+    return {
+        "per_token_writes": N * STATE_BYTES + per_token,  # read S0 + T writes
+        "b4_verify": N * (STATE_BYTES + T * rec_tok),
+        "b4_commit": N * (2 * STATE_BYTES + n_acc * rec_tok),
+    }
+
+
+def bench(N, T, rows, gen):
+    mixed_qkv, ba, gate, A_log, dt_bias, cu = make_inputs(N, T, gen)
+    tok = N * T
+    b, a = ba[:, :HV], ba[:, HV:]
+    q = mixed_qkv[:, : H * K].view(tok, H, K)
+    k = mixed_qkv[:, H * K : 2 * H * K].view(tok, H, K)
+    v = mixed_qkv[:, 2 * H * K :].view(tok, HV, V)
+    norm_w = torch.ones(V, dtype=torch.bfloat16, device=DEV)
+    acc = torch.full((N,), max(1, (T + 1) // 2), dtype=torch.int32, device=DEV)
+    res = {"N": N, "T": T}
+
+    # --- baseline Triton (per-token state slots) ---
+    rot = max(1, -(-MIN_ROTATION_BYTES // (N * T * STATE_BYTES)))
+    pool = torch.zeros((1 + rot * N * T, HV, V, K), device=DEV)
+    idxs = [
+        (1 + r * N * T + torch.arange(N * T, device=DEV, dtype=torch.int32)).view(N, T)
+        for r in range(rot)
+    ]
+    ones = torch.ones(N, dtype=torch.int32, device=DEV)
+    q4, k4, v4 = (x.contiguous().unsqueeze(0) for x in (q, k, v))
+    a3, b3 = a.contiguous().unsqueeze(0), b.contiguous().unsqueeze(0)
+
+    def tri(idx):
+        return lambda: fused_sigmoid_gating_delta_rule_update(
+            A_log=A_log, a=a3, b=b3, dt_bias=dt_bias, q=q4, k=k4, v=v4,
+            initial_state=pool, inplace_final_state=True, cu_seqlens=cu,
+            ssm_state_indices=idx, num_accepted_tokens=ones,
+            use_qk_l2norm_in_kernel=True,
+        )  # fmt: skip
+
+    res["triton_us"] = graph_time_us([tri(i) for i in idxs])
+
+    out = torch.empty((tok, HV, V), dtype=torch.bfloat16, device=DEV)
+
+    def norm():
+        layer_norm_fwd(
+            out.view(-1, V), norm_w, None, 1e-6, z=gate.view(-1, V),
+            out=out.view(-1, V), group_size=V, norm_before_gate=True,
+            is_rms_norm=True, activation="silu",
+        )  # fmt: skip
+
+    res["rmsnorm_us"] = graph_time_us([norm])
+
+    # --- CUDA fused (per-token state slots, norm fused) ---
+    if hasattr(torch.ops._C, "fused_gdn_decode_post_conv_mtp"):
+        from vllm import _custom_ops as ops
+
+        a_c, b_c = a.contiguous(), b.contiguous()
+
+        def cud(idx):
+            return lambda: ops.fused_gdn_decode_post_conv_mtp(
+                mixed_qkv=mixed_qkv, a=a_c, b=b_c, A_log=A_log, dt_bias=dt_bias,
+                state_indices=idx, cu_seqlens=cu, num_accepted_tokens=ones,
+                state=pool, output_gate=gate, norm_weight=norm_w, out=out,
+                scale=K**-0.5, norm_eps=1e-6, output_gate_activation="silu",
+            )  # fmt: skip
+
+        res["cuda_us"] = graph_time_us([cud(i) for i in idxs])
+
+    # --- B4: verify (+norm) and commit, one slot per request ---
+    rot = max(1, -(-MIN_ROTATION_BYTES // (N * STATE_BYTES)))
+    n_slots = 1 + rot * N
+    state = torch.zeros((n_slots, HV, V, K), device=DEV)
+    rec = GDNRecoverRecords.allocate(
+        n_slots, H, HV, K, V, T - 1, torch.bfloat16, DEV, window=1
+    )
+    slot_sets = [
+        1 + r * N + torch.arange(N, device=DEV, dtype=torch.int32) for r in range(rot)
+    ]
+
+    def ver(slots):
+        return lambda: gdn_recover_verify(
+            q, k, v, a, b, A_log, dt_bias, state, rec, cu, slots, out=out
+        )
+
+    res["b4_verify_us"] = graph_time_us([ver(s) for s in slot_sets])
+    group1 = GDNRecoverCommitGroup([state], [rec], num_k_heads=H)
+
+    def com(group, slots):
+        return lambda: group.commit(slots, cu, acc)
+
+    res["b4_commit_us"] = graph_time_us([com(group1, s) for s in slot_sets])
+    # One launch for a whole cache group (16 GDN layers in Qwen3.8), each
+    # layer with its own buffers; rotate slots so the group misses L2.
+    rot16 = max(1, -(-MIN_ROTATION_BYTES // (rows * N * STATE_BYTES)))
+    n16 = 1 + rot16 * N
+    states = [torch.zeros((n16, HV, V, K), device=DEV) for _ in range(rows)]
+    recs = [
+        GDNRecoverRecords.allocate(n16, H, HV, K, V, T - 1, torch.bfloat16, DEV)
+        for _ in range(rows)
+    ]
+    group16 = GDNRecoverCommitGroup(states, recs, num_k_heads=H)
+    res[f"b4_commit_x{rows}_per_layer_us"] = (
+        graph_time_us([com(group16, s) for s in slot_sets[:rot16]]) / rows
+    )
+    res["b4_total_us"] = (
+        res["b4_verify_us"] + res["rmsnorm_us"] + res[f"b4_commit_x{rows}_per_layer_us"]
+    )
+    res["triton_plus_norm_us"] = res["triton_us"] + res["rmsnorm_us"]
+    res["bytes"] = bytes_model(N, T, int(acc[0]))
+    torch.cuda.empty_cache()
+    return res
+
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--batch", type=int, nargs="+", default=[1, 16, 64])
+    p.add_argument("--tokens", type=int, nargs="+", default=[4, 8])
+    p.add_argument("--group-layers", type=int, default=16)
+    p.add_argument("--out", default=None)
+    args = p.parse_args()
+    gen = torch.Generator(device=DEV).manual_seed(0)
+    results = []
+    hdr = (
+        f"{'N':>4} {'T':>2} | {'triton':>8} {'+norm':>8} {'cuda':>8} | "
+        f"{'verify':>8} {'norm':>7} {'commit':>8} {'commit/L':>8} {'b4 tot':>8} | "
+        f"{'MiB pt':>7} {'MiB b4':>7}"
+    )
+    print(hdr)
+    for T in args.tokens:
+        for N in args.batch:
+            r = bench(N, T, args.group_layers, gen)
+            results.append(r)
+            bm = r["bytes"]
+            cl = r[f"b4_commit_x{args.group_layers}_per_layer_us"]
+            print(
+                f"{N:>4} {T:>2} | {r['triton_us']:8.1f} {r['triton_plus_norm_us']:8.1f} "
+                f"{r.get('cuda_us', float('nan')):8.1f} | {r['b4_verify_us']:8.1f} "
+                f"{r['rmsnorm_us']:7.1f} {r['b4_commit_us']:8.1f} {cl:8.1f} "
+                f"{r['b4_total_us']:8.1f} | {bm['per_token_writes'] / 2**20:7.1f} "
+                f"{(bm['b4_verify'] + bm['b4_commit']) / 2**20:7.1f}",
+                flush=True,
+            )
+    if args.out:
+        with open(args.out, "w") as f:
+            json.dump(results, f, indent=1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/kernels/mamba/test_gdn_recover_spec.py b/tests/kernels/mamba/test_gdn_recover_spec.py
new file mode 100644
index 000000000..2e0ed31e7
--- /dev/null
+++ b/tests/kernels/mamba/test_gdn_recover_spec.py
@@ -0,0 +1,391 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""GDN spec-decode verify-records + commit (no per-draft-token state writes).
+
+Reference ("same-path baseline"): fused_sigmoid_gating_delta_rule_update with
+2-D ssm_state_indices / num_accepted_tokens, i.e. the Triton spec-decode path
+that stores the full state after every verified token. The records path must
+reproduce its outputs and the accepted state bit-exactly (fp32 state).
+
+Set GDN_RECOVER_DIFF_JSON=<path> to dump the diff against the CUDA
+fused_gdn_decode_post_conv_mtp kernel (not required to be exact).
+"""
+
+import json
+import os
+
+import pytest
+import torch
+
+from vllm.model_executor.layers.mamba.ops.gdn_recover_spec import (
+    GDNRecoverCommitGroup,
+    GDNRecoverRecords,
+    GDNRecoverTrackers,
+    gdn_recover_reset_trackers,
+    gdn_recover_verify,
+)
+from vllm.third_party.flash_linear_attention.ops.fused_sigmoid_gating import (
+    fused_sigmoid_gating_delta_rule_update,
+)
+
+INTERPRET = os.environ.get("TRITON_INTERPRET") == "1"
+DEV = "cpu" if INTERPRET else "cuda"
+if not INTERPRET and not torch.cuda.is_available():
+    pytest.skip("GDN recover spec kernels need CUDA", allow_module_level=True)
+
+K = V = 128
+# Qwen3.8-27B GDN heads (TP1); the interpreter run uses fewer v-heads.
+H = 16 if not INTERPRET else 2
+HV = 48 if not INTERPRET else 6
+
+
+def _bits(x: torch.Tensor) -> torch.Tensor:
+    return x.view({4: torch.int32, 2: torch.int16}[x.element_size()])
+
+
+def _assert_bitexact(got: torch.Tensor, ref: torch.Tensor, what: str) -> None:
+    assert got.shape == ref.shape and got.dtype == ref.dtype, what
+    if not torch.equal(_bits(got), _bits(ref)):
+        diff = (got.float() - ref.float()).abs()
+        n_bad = int((_bits(got) != _bits(ref)).sum())
+        raise AssertionError(
+            f"{what}: {n_bad}/{got.numel()} elements differ, "
+            f"max abs diff {diff.max().item():.3e}"
+        )
+
+
+class _Step:
+    """Random post-conv inputs of one spec-decode step (N requests)."""
+
+    def __init__(self, qlens: list[int], gen: torch.Generator, num_v_heads=HV):
+        self.qlens = qlens
+        self.N = len(qlens)
+        self.T = sum(qlens)
+        hv = num_v_heads
+        self.hv = hv
+        conv_dim = 2 * H * K + hv * V
+        # Post-conv SiLU activations; v larger than q/k as in the model.
+        self.mixed_qkv = (
+            torch.randn((self.T, conv_dim), generator=gen, device=DEV) * 0.5
+        ).to(torch.bfloat16)
+        self.mixed_qkv[:, 2 * H * K :] *= 4
+        qkv = self.mixed_qkv
+        self.q = qkv[:, : H * K].view(self.T, H, K)
+        self.k = qkv[:, H * K : 2 * H * K].view(self.T, H, K)
+        self.v = qkv[:, 2 * H * K :].view(self.T, hv, V)
+        ba = torch.randn((self.T, 2 * hv), generator=gen, device=DEV).to(torch.bfloat16)
+        self.b, self.a = ba[:, :hv], ba[:, hv:]  # strided views, as split_ba
+        self.cu = torch.zeros(self.N + 1, dtype=torch.int32, device=DEV)
+        self.cu[1:] = torch.cumsum(torch.tensor(qlens, device=DEV), 0)
+
+
+def _params(gen, num_v_heads=HV):
+    A_log = torch.log(torch.rand(num_v_heads, generator=gen, device=DEV) * 15 + 1)
+    dt_bias = torch.randn(num_v_heads, generator=gen, device=DEV)
+    return A_log, dt_bias
+
+
+def _reference(step: _Step, A_log, dt_bias, s0: torch.Tensor, t_max: int):
+    """Baseline Triton path: per-token states in [N, t_max] slots."""
+    N = step.N
+    pool = torch.zeros((1 + N * t_max, step.hv, V, K), device=DEV)
+    idx = torch.arange(1, 1 + N * t_max, device=DEV, dtype=torch.int32).view(N, t_max)
+    pool[idx[:, 0].long()] = s0
+    acc = torch.ones(N, dtype=torch.int32, device=DEV)
+    o, _ = fused_sigmoid_gating_delta_rule_update(
+        A_log=A_log,
+        a=step.a.unsqueeze(0),
+        b=step.b.unsqueeze(0),
+        dt_bias=dt_bias,
+        q=step.q.unsqueeze(0),
+        k=step.k.unsqueeze(0),
+        v=step.v.unsqueeze(0),
+        initial_state=pool,
+        inplace_final_state=True,
+        cu_seqlens=step.cu,
+        ssm_state_indices=idx,
+        num_accepted_tokens=acc,
+        use_qk_l2norm_in_kernel=True,
+    )
+    return o.squeeze(0), pool, idx
+
+
+def _new_cache(N, gen, num_spec, window=1, num_v_heads=HV, extra_slots=0):
+    num_slots = 1 + N + extra_slots
+    state = torch.randn((num_slots, num_v_heads, V, K), generator=gen, device=DEV)
+    rec = GDNRecoverRecords.allocate(
+        num_slots, H, num_v_heads, K, V, num_spec, torch.bfloat16, DEV, window
+    )
+    return state, rec
+
+
+def _rand_qlens(N, t_max, gen, ragged):
+    if not ragged:
+        return [t_max] * N
+    return torch.randint(1, t_max + 1, (N,), generator=gen).tolist()
+
+
+@pytest.mark.parametrize("t_max", [4, 8])
+@pytest.mark.parametrize("N", [1, 4, 32])
+@pytest.mark.parametrize("ragged", [False, True])
+def test_verify_commit_bitexact(N, t_max, ragged):
+    if INTERPRET and N > 4:
+        pytest.skip("slow under the interpreter")
+    gen = torch.Generator(device=DEV).manual_seed(1000 * N + t_max + ragged)
+    cpu_gen = torch.Generator().manual_seed(N + t_max)
+    qlens = _rand_qlens(N, t_max, cpu_gen, ragged)
+    step = _Step(qlens, gen)
+    A_log, dt_bias = _params(gen)
+    state, rec = _new_cache(N, gen, num_spec=t_max - 1)
+    slots = torch.arange(1, N + 1, dtype=torch.int32, device=DEV)
+    s0 = state[1:].clone()
+
+    o_ref, pool, idx = _reference(step, A_log, dt_bias, s0, t_max)
+
+    out = torch.full((step.T, HV, V), float("nan"), device=DEV, dtype=torch.bfloat16)
+    gdn_recover_verify(
+        step.q, step.k, step.v, step.a, step.b, A_log, dt_bias,
+        state, rec, step.cu, slots, out=out,
+    )  # fmt: skip
+    _assert_bitexact(out, o_ref, "verify output")
+    _assert_bitexact(state[1:], s0, "checkpoint untouched by verify")
+
+    acc = torch.tensor(
+        [int(torch.randint(1, q + 1, (1,), generator=cpu_gen)) for q in qlens],
+        dtype=torch.int32,
+        device=DEV,
+    )
+    acc[0] = qlens[0]  # always cover full acceptance
+    group = GDNRecoverCommitGroup([state], [rec], num_k_heads=H)
+    group.commit(slots, step.cu, acc)
+    ref_state = pool[idx[torch.arange(N), acc.long() - 1].long()]
+    _assert_bitexact(state[1:], ref_state, "committed state")
+
+
+@pytest.mark.parametrize("window", [1, 2, 3])
+def test_multistep_window(window):
+    """Several steps, with W > 1 keeping records pending across steps."""
+    N, t_max, steps = (3, 4, 5) if INTERPRET else (8, 4, 6)
+    gen = torch.Generator(device=DEV).manual_seed(7 + window)
+    cpu_gen = torch.Generator().manual_seed(window)
+    A_log, dt_bias = _params(gen)
+    state, rec = _new_cache(N, gen, num_spec=t_max - 1, window=window)
+    slots = torch.arange(1, N + 1, dtype=torch.int32, device=DEV)
+    tr = None
+    if window > 1:
+        tr = GDNRecoverTrackers(
+            torch.zeros(state.shape[0], dtype=torch.int32, device=DEV),
+            torch.zeros(state.shape[0], dtype=torch.int32, device=DEV),
+        )
+    group = GDNRecoverCommitGroup(
+        [state], [rec], num_k_heads=H, window=window, trackers=tr
+    )
+    s_ref = state[1:].clone()
+    for _ in range(steps):
+        qlens = _rand_qlens(N, t_max, cpu_gen, ragged=True)
+        step = _Step(qlens, gen)
+        o_ref, pool, idx = _reference(step, A_log, dt_bias, s_ref, t_max)
+        out = torch.empty((step.T, HV, V), device=DEV, dtype=torch.bfloat16)
+        gdn_recover_verify(
+            step.q, step.k, step.v, step.a, step.b, A_log, dt_bias,
+            state, rec, step.cu, slots, out=out, window=window, trackers=tr,
+        )  # fmt: skip
+        _assert_bitexact(out, o_ref, f"verify output (W={window})")
+        acc = torch.tensor(
+            [int(torch.randint(1, q + 1, (1,), generator=cpu_gen)) for q in qlens],
+            dtype=torch.int32,
+            device=DEV,
+        )
+        group.commit(slots, step.cu, acc)
+        s_ref = pool[idx[torch.arange(N), acc.long() - 1].long()]
+    # Fold what is still pending (finish / preemption) without a new step.
+    empty_cu = torch.zeros(N + 1, dtype=torch.int32, device=DEV)
+    group.commit(slots, empty_cu, torch.ones(N, dtype=torch.int32, device=DEV),
+                 force=True)  # fmt: skip
+    _assert_bitexact(state[1:], s_ref, f"state after forced fold (W={window})")
+    if tr is not None:
+        assert int(tr.num_pending.abs().sum()) == 0
+        gdn_recover_reset_trackers(tr, slots)
+
+
+def test_padding_and_null_slots():
+    """Slot <= 0 rows (FULL-graph padding): no output, records or state."""
+    N, t_max = 4, 4
+    gen = torch.Generator(device=DEV).manual_seed(3)
+    step = _Step([t_max] * N, gen)
+    A_log, dt_bias = _params(gen)
+    state, rec = _new_cache(N, gen, num_spec=t_max - 1)
+    slots = torch.tensor([1, 0, 3, -1], dtype=torch.int32, device=DEV)
+    before = state.clone()
+    rec_before = [x.clone() for x in (rec.u, rec.k, rec.g)]
+    out = torch.full((step.T, HV, V), 7.0, device=DEV, dtype=torch.bfloat16)
+    gdn_recover_verify(
+        step.q, step.k, step.v, step.a, step.b, A_log, dt_bias,
+        state, rec, step.cu, slots, out=out,
+    )  # fmt: skip
+    for n in (1, 3):
+        assert torch.all(out[n * t_max : (n + 1) * t_max] == 7.0)
+    # The null block's records stay untouched.
+    for x, x0 in zip((rec.u, rec.k, rec.g), rec_before):
+        _assert_bitexact(x[0], x0[0], "null-slot records")
+    GDNRecoverCommitGroup([state], [rec], num_k_heads=H).commit(
+        slots, step.cu, torch.full((N,), t_max, dtype=torch.int32, device=DEV)
+    )
+    for s in (0, 2, 4):
+        _assert_bitexact(state[s], before[s], f"slot {s}")
+
+
+def test_dst_and_boundary_slots():
+    """Align-mode hooks: commit to another slot, and materialize the state
+    after a block boundary inside the accepted tokens."""
+    N, t_max = 3, 8
+    gen = torch.Generator(device=DEV).manual_seed(5)
+    step = _Step([t_max] * N, gen)
+    A_log, dt_bias = _params(gen)
+    state, rec = _new_cache(N, gen, num_spec=t_max - 1, extra_slots=2 * N)
+    slots = torch.arange(1, N + 1, dtype=torch.int32, device=DEV)
+    s0 = state[1 : N + 1].clone()
+    o_ref, pool, idx = _reference(step, A_log, dt_bias, s0, t_max)
+    gdn_recover_verify(
+        step.q, step.k, step.v, step.a, step.b, A_log, dt_bias,
+        state, rec, step.cu, slots,
+    )  # fmt: skip
+    acc = torch.tensor([8, 5, 3], dtype=torch.int32, device=DEV)
+    b_lens = torch.tensor([2, 5, 4], dtype=torch.int32, device=DEV)  # 4 > acc
+    dst = slots + N
+    bnd = slots + 2 * N
+    before = state.clone()
+    GDNRecoverCommitGroup([state], [rec], num_k_heads=H).commit(
+        slots, step.cu, acc, dst_slots=dst, boundary_slots=bnd, boundary_lens=b_lens
+    )
+    _assert_bitexact(state[1 : N + 1], s0, "source slot kept")
+    rows = torch.arange(N)
+    _assert_bitexact(
+        state[dst.long()], pool[idx[rows, acc.long() - 1].long()], "dst state"
+    )
+    for n in range(N):
+        if b_lens[n] <= acc[n]:
+            ref_b = pool[idx[n, b_lens[n].item() - 1].long()]
+        else:
+            ref_b = before[bnd[n].item()]
+        _assert_bitexact(state[bnd[n].item()], ref_b, f"boundary state row {n}")
+
+
+def test_multilayer_commit_and_row_indices():
+    """One launch commits several layers; spec rows map to batch rows."""
+    N, t_max, L = 4, 4, 3
+    gen = torch.Generator(device=DEV).manual_seed(11)
+    cpu_gen = torch.Generator().manual_seed(11)
+    A_log, dt_bias = _params(gen)
+    slots = torch.arange(1, N + 1, dtype=torch.int32, device=DEV)
+    acc_batch = torch.tensor([0, 2, 9, 4, 3, 1], dtype=torch.int32, device=DEV)
+    row_indices = torch.tensor([1, 2, 4, 5], dtype=torch.int32, device=DEV)
+    qlens = _rand_qlens(N, t_max, cpu_gen, ragged=True)
+    states, recs, refs = [], [], []
+    for _ in range(L):
+        step = _Step(qlens, gen)
+        state, rec = _new_cache(N, gen, num_spec=t_max - 1)
+        o_ref, pool, idx = _reference(step, A_log, dt_bias, state[1:].clone(), t_max)
+        gdn_recover_verify(
+            step.q, step.k, step.v, step.a, step.b, A_log, dt_bias,
+            state, rec, step.cu, slots,
+        )  # fmt: skip
+        states.append(state)
+        recs.append(rec)
+        refs.append((pool, idx, step))
+    GDNRecoverCommitGroup(states, recs, num_k_heads=H).commit(
+        slots, refs[0][2].cu, acc_batch, row_indices=row_indices
+    )
+    n_acc = [
+        max(1, min(int(acc_batch[r]), q)) for r, q in zip(row_indices.tolist(), qlens)
+    ]
+    for layer, (pool, idx, _) in enumerate(refs):
+        ref = pool[idx[torch.arange(N), torch.tensor(n_acc) - 1].long()]
+        _assert_bitexact(states[layer][1:], ref, f"layer {layer} committed state")
+
+
+@pytest.mark.skipif(INTERPRET, reason="CUDA kernel")
