+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Prefix caching (mamba_cache_mode "align") with VLLM_GDN_SPEC_STATE=recover.
+
+Drives the model runner's align lifecycle for one GDN layer over many spec
+steps that cross block boundaries, in both modes:
+  preprocess_mamba_align_fused_kernel + MambaSpecDecodeGPUContext precopy,
+  _forward_core (real GDN metadata, aligned state indices),
+  recover commit (GDNRecoverSpecMetadata.commit_recoverssm_state),
+  MambaSpecDecodeGPUContext.run_fused_postprocess_align.
+Outputs, every block-boundary state (what prefix caching stores) and the
+final running state must be bit-identical to the per-token path.
+"""
+
+import os
+import types
+from unittest.mock import patch
+
+import pytest
+import torch
+
+from vllm.platforms import current_platform
+
+if not current_platform.is_cuda():
+    pytest.skip("CUDA only", allow_module_level=True)
+
+from tests.v1.attention.utils import (  # noqa: E402
+    BatchSpec,
+    create_common_attn_metadata,
+    create_vllm_config,
+)
+from vllm.config import SpeculativeConfig, set_current_vllm_config  # noqa: E402
+from vllm.model_executor.layers.mamba.gdn import qwen_gdn_linear_attn  # noqa: E402
+from vllm.model_executor.layers.mamba.gdn.qwen_gdn_linear_attn import (  # noqa: E402
+    QwenGatedDeltaNetAttention,
+)
+from vllm.model_executor.layers.mamba.mamba_utils import (  # noqa: E402
+    MambaStateCopyFuncCalculator,
+    MambaStateShapeCalculator,
+)
+from vllm.v1.attention.backends.gdn_attn import (  # noqa: E402
+    GDNAttentionMetadataBuilder,
+    GDNRecoverSpecMetadata,
+)
+from vllm.v1.attention.backends.registry import (  # noqa: E402
+    MambaAttentionBackendEnum,
+)
+from vllm.v1.attention.backends.utils import (  # noqa: E402
+    mamba_get_block_table_tensor,
+)
+from vllm.v1.kv_cache_interface import (  # noqa: E402
+    KVCacheConfig,
+    KVCacheGroupSpec,
+    MambaSpec,
+)
+from vllm.v1.worker.mamba_utils import (  # noqa: E402
+    MambaSpecDecodeGPUContext,
+    preprocess_mamba_align_fused_kernel,
+)
+
+NUM_SPEC = 3
+T = NUM_SPEC + 1
+H, HV, K, V = 2, 6, 128, 128
+CONV_KERNEL = 4
+CONV_DIM = 2 * H * K + HV * V
+BS = 8  # mamba block size: boundaries every 8 tokens
+COLS = 24
+PREFIX = "model.layers.0.linear_attn"
+MODEL = os.environ.get("GDN_RECOVER_TEST_MODEL", "Qwen/Qwen3.5-0.8B")
+DEV = torch.device("cuda")
+
+
+def _bits(x):
+    return x.view({4: torch.int32, 2: torch.int16}[x.element_size()])
+
+
+def _run(monkeypatch, mode, computed0, steps, inputs, accepted, init, params):
+    recover = mode == "recover"
+    monkeypatch.setenv("VLLM_GDN_SPEC_STATE", mode)
+    monkeypatch.setenv("VLLM_GDN_SPEC_STATE_W", "1")
+    N = len(computed0)
+    vllm_config = create_vllm_config(
+        model_name=MODEL, block_size=BS, hf_config_override={"linear_key_head_dim": K}
+    )
+    vllm_config.additional_config = {"gdn_prefill_backend": "triton"}
+    vllm_config.cache_config.mamba_cache_mode = "align"
+    vllm_config.speculative_config = SpeculativeConfig(
+        method="ngram", num_speculative_tokens=NUM_SPEC
+    )
+    shapes = MambaStateShapeCalculator.gated_delta_net_state_shape(
+        1, H, HV, K, V, CONV_KERNEL, NUM_SPEC
+    )
+    num_slots = 1 + N * COLS
+    conv = torch.zeros(num_slots, *shapes[0], device=DEV, dtype=torch.bfloat16)
+    ssm = torch.zeros(num_slots, *shapes[1], device=DEV)
+    kv_cache = [conv, ssm]
+    if recover:
+        kv_cache += [
+            torch.zeros(num_slots, *shapes[2], device=DEV),
+            torch.zeros(num_slots, *shapes[3], device=DEV, dtype=torch.bfloat16),
+            torch.zeros(num_slots, *shapes[4], device=DEV),
+        ]
+    spec = MambaSpec(
+        block_size=BS,
+        shapes=tuple(shapes),
+        dtypes=(torch.bfloat16, torch.float32)
+        + ((torch.float32, torch.bfloat16, torch.float32) if recover else ()),
+        mamba_type=MambaAttentionBackendEnum.GDN_ATTN,
+        mamba_cache_mode="align",
+        num_speculative_blocks=0 if recover else NUM_SPEC,
+    )
+    table = (1 + torch.arange(N * COLS, device=DEV, dtype=torch.int32)).view(N, COLS)
+    a_log, dt_bias, conv_weight = params
+    layer = types.SimpleNamespace(
+        prefix=PREFIX,
+        enable_packed_recurrent_decode=False,
+        tp_size=1,
+        num_k_heads=H,
+        num_v_heads=HV,
+        head_k_dim=K,
+        head_v_dim=V,
+        key_dim=H * K,
+        value_dim=HV * V,
+        activation="silu",
+        A_log=a_log,
+        dt_bias=dt_bias,
+        conv1d=types.SimpleNamespace(weight=conv_weight, bias=None),
+        kv_cache=kv_cache,
+        num_spec=NUM_SPEC,
+        spec_recover=recover,
+        recover_window=1,
+        uses_gdn_recover_trackers=False,
+        use_flashinfer_replayssm=False,
+        gdn_decode_kernel="triton",
+        gdn_prefill_backend="triton",
+    )
+    for name in ("rearrange_mixed_qkv", "_forward_core", "_recover_spec_verify"):
+        fn = getattr(QwenGatedDeltaNetAttention, name)
+        setattr(layer, name, types.MethodType(fn, layer))
+    forward_context = {PREFIX: layer}
+    vllm_config.compilation_config.static_forward_context[PREFIX] = layer
+
+    kv_cache_config = KVCacheConfig(
+        num_blocks=num_slots,
+        kv_cache_tensors=[],
+        kv_cache_groups=[KVCacheGroupSpec(layer_names=[PREFIX], kv_cache_spec=spec)],
+    )
+    copy_funcs = {
+        MambaAttentionBackendEnum.GDN_ATTN: (
+            MambaStateCopyFuncCalculator.gated_delta_net_state_copy_func()
+        )
+    }
+    ctx = MambaSpecDecodeGPUContext.create(
+        max_num_reqs=N,
+        kv_cache_config=kv_cache_config,
+        copy_funcs=copy_funcs,
+        forward_context=forward_context,
+        device=DEV,
+    )
+    ctx.initialize_from_forward_context(
+        kv_cache_config, forward_context, copy_funcs, [table], [table]
+    )
+    assert ctx.recover_spec == recover
+    builder = GDNAttentionMetadataBuilder(
+        kv_cache_spec=spec, layer_names=[PREFIX], vllm_config=vllm_config, device=DEV
+    )
+    assert builder.spec_recover == recover
+
+    # Model-runner state (MambaHybridModelState).
+    idx_mapping = torch.arange(N, device=DEV, dtype=torch.int32)
+    computed = torch.tensor(computed0, device=DEV, dtype=torch.int32)
+    state_idx = (computed - 1) // BS
+    num_accepted = torch.ones(N, device=DEV, dtype=torch.int32)
+    src_col = torch.full((N,), -1, device=DEV, dtype=torch.int32)
+    src_off = torch.zeros(N, device=DEV, dtype=torch.int32)
+    run_slots = table[torch.arange(N), state_idx.long()].long()
+    conv[run_slots], ssm[run_slots] = init
+
+    outs = []
+    for s in range(steps):
+        qsl = torch.arange(0, (N + 1) * T, T, device=DEV, dtype=torch.int32)
+        preprocess_mamba_align_fused_kernel[(1,)](
+            idx_mapping,
+            state_idx,
+            computed,
+            qsl,
+            num_accepted,
+            src_col,
+            src_off,
+            N,
+            BLOCK_SIZE=256,
+            MAMBA_BLOCK_SIZE=BS,
+        )
+        ctx.run_fused_precopy(N, state_idx, src_col, src_off, idx_mapping)
+        seq_lens = (computed + T).tolist()
+        batch = BatchSpec(seq_lens=seq_lens, query_lens=[T] * N)
+        common = create_common_attn_metadata(batch, BS, DEV)
+        common = common.replace(block_table_tensor=table)
+        builder.mamba_aligned_state_indices = mamba_get_block_table_tensor(
+            table, common.seq_lens, spec, "align"
+        )
+        with set_current_vllm_config(vllm_config):
+            meta = builder.build(
+                common_prefix_len=0,
+                common_attn_metadata=common,
+                num_accepted_tokens=num_accepted.clone(),
+                num_decode_draft_tokens_cpu=torch.full(
+                    (N,), NUM_SPEC, dtype=torch.int32
+                ),
+            )
+        assert isinstance(meta, GDNRecoverSpecMetadata) == recover
+        mixed_qkv, ba = inputs[s]
+        out = torch.zeros(N * T, HV, V, device=DEV, dtype=torch.bfloat16)
+        context = types.SimpleNamespace(attn_metadata={PREFIX: meta})
+        with patch.object(
+            qwen_gdn_linear_attn, "get_forward_context", return_value=context
+        ):
+            layer._forward_core(
+                mixed_qkv=mixed_qkv.clone(),
+                b=ba[:, :HV],
+                a=ba[:, HV:],
+                core_attn_out=out,
+            )
+        outs.append(out)
+        # postprocess_state
+        num_sampled = accepted[s].to(DEV)
+        num_accepted.copy_(num_sampled.clamp_min(1))
+        if recover:
+            assert meta.commit_recoverssm_state(num_sampled) is None
+        computed = computed + num_sampled
+        ctx.run_fused_postprocess_align(
+            N, num_accepted, state_idx, computed, idx_mapping
+        )
+
+    # The per-token path's accepted state sits num_accepted - 1 columns past
+    # the running block; recover keeps it in the running block.
+    rows = torch.arange(N)
+    final_col = state_idx.long() + (0 if recover else num_accepted.long() - 1)
+    final = ssm[table[rows, final_col.cpu()].long()].clone()
+    run_conv = conv[table[rows, state_idx.long().cpu()].long()].clone()
+    boundary = {}
+    for r in range(N):
+        for b in range(BS, int(computed[r]) + 1, BS):
+            if b > computed0[r]:
+                slot = int(table[r, b // BS - 1])
+                boundary[(r, b)] = (ssm[slot].clone(), conv[slot].clone())
+    return outs, final, run_conv, num_accepted.clone(), boundary
+
+
+@pytest.mark.parametrize("seed", [0, 1])
+@torch.inference_mode()
+def test_align_recover_matches_per_token(monkeypatch, seed):
+    torch.manual_seed(seed)
+    gen = torch.Generator().manual_seed(seed)
+    computed0 = [5, 13, 1]
+    N, steps = len(computed0), 12
+    conv_shape, ssm_shape = MambaStateShapeCalculator.gated_delta_net_state_shape(
+        1, H, HV, K, V, CONV_KERNEL, NUM_SPEC
+    )[:2]
+    init = (
+        0.05 * torch.randn(N, *conv_shape, device=DEV).to(torch.bfloat16),
+        0.05 * torch.randn(N, *ssm_shape, device=DEV),
+    )
+    params = (
+        torch.log(torch.rand(HV, device=DEV) * 15 + 1),
+        0.1 * torch.randn(HV, device=DEV),
+        0.3 * torch.randn(CONV_DIM, 1, CONV_KERNEL, device=DEV).to(torch.bfloat16),
+    )
+    inputs = [
+        (
+            torch.randn(N * T, CONV_DIM, device=DEV).to(torch.bfloat16),
+            torch.randn(N * T, 2 * HV, device=DEV).to(torch.bfloat16),
+        )
+        for _ in range(steps)
+    ]
+    accepted = torch.randint(1, T + 1, (steps, N), generator=gen).to(torch.int32)
+    ref = _run(
+        monkeypatch, "per_token", computed0, steps, inputs, accepted, init, params
+    )
+    rec = _run(monkeypatch, "recover", computed0, steps, inputs, accepted, init, params)
+    for s in range(steps):
+        assert torch.isfinite(ref[0][s].float()).all()
+        assert torch.equal(_bits(rec[0][s]), _bits(ref[0][s])), f"output step {s}"
+    assert torch.equal(_bits(rec[1]), _bits(ref[1])), "final state"
+    assert torch.equal(rec[3], ref[3]), "num_accepted (conv offsets)"
+    assert torch.equal(_bits(rec[2]), _bits(ref[2])), "running conv state"
+    assert ref[4].keys() == rec[4].keys() and len(ref[4]) >= N
+    for key, (s_ref, c_ref) in ref[4].items():
+        s_rec, c_rec = rec[4][key]
+        assert torch.equal(_bits(s_rec), _bits(s_ref)), f"boundary state {key}"
+        assert torch.equal(_bits(c_rec), _bits(c_ref)), f"boundary conv {key}"
