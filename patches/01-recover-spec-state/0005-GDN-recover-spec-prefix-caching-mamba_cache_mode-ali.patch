+def test_align_boundary_from_block_table():
+    """Align mode: the commit finds the crossed block boundary from the
+    pre-step computed-token count and stores that state into the boundary
+    block (the per-token path copies it from its spec column)."""
+    bs, t_max, cols = 8, 4, 4
+    computed = [5, 6, 12, 3]
+    acc = [4, 1, 4, 4]  # crosses at token 3 / no / at the end / no
+    N = len(computed)
+    gen = torch.Generator(device=DEV).manual_seed(77)
+    step = _Step([t_max] * N, gen)
+    A_log, dt_bias = _params(gen)
+    num_slots = 1 + N * cols
+    state = torch.randn((num_slots, HV, V, K), generator=gen, device=DEV)
+    rec = GDNRecoverRecords.allocate(
+        num_slots, H, HV, K, V, t_max - 1, torch.bfloat16, DEV
+    )
+    table = (1 + torch.arange(N * cols, dtype=torch.int32, device=DEV)).view(N, cols)
+    run_col = [(c + t_max - 1) // bs for c in computed]  # (seq_len - 1) // bs
+    slots = table[torch.arange(N), torch.tensor(run_col)].contiguous()
+    s0 = state[slots.long()].clone()
+    o_ref, pool, idx = _reference(step, A_log, dt_bias, s0, t_max)
+    gdn_recover_verify(
+        step.q, step.k, step.v, step.a, step.b, A_log, dt_bias,
+        state, rec, step.cu, slots,
+    )  # fmt: skip
+    before = state.clone()
+    GDNRecoverCommitGroup([state], [rec], num_k_heads=H).commit(
+        slots,
+        step.cu,
+        torch.tensor(acc, dtype=torch.int32, device=DEV),
+        block_table=table,
+        num_computed_tokens=torch.tensor(computed, dtype=torch.int32, device=DEV),
+        mamba_block_size=bs,
+    )
+    touched = set()
+    for n in range(N):
+        _assert_bitexact(
+            state[slots[n]], pool[idx[n, acc[n] - 1]], f"final state row {n}"
+        )
+        touched.add(int(slots[n]))
+        nb = (computed[n] // bs + 1) * bs
+        if nb - computed[n] <= acc[n] and nb // bs - 1 != run_col[n]:
+            b = int(table[n, nb // bs - 1])
+            _assert_bitexact(
+                state[b], pool[idx[n, nb - computed[n] - 1]], f"boundary row {n}"
+            )
+            touched.add(b)
+    assert touched == {int(slots[0]), int(table[0, 0])} | set(slots.tolist())
+    for sl in range(num_slots):
+        if sl not in touched:
+            _assert_bitexact(state[sl], before[sl], f"untouched slot {sl}")
+
+
 def test_multilayer_commit_and_row_indices():
     """One launch commits several layers; spec rows map to batch rows."""
     N, t_max, L = 4, 4, 3
