             if reason is not None:
@@ -2224,8 +2239,11 @@ class QwenGatedDeltaNetAttention(GatedDeltaNetAttention):
             out = mixed_qkv_spec.new_empty(
                 (1, num_tokens, num_v_heads, self.head_v_dim)
             )
-        _, ssm_state, rec_u, rec_k, rec_g = self.kv_cache
+        ssm_state = self.kv_cache[1]
         window = getattr(self, "recover_window", 1)
+        records = getattr(self, "_recover_records", None)
+        if records is None:
+            records = GDNRecoverRecords(*self.kv_cache[2:5])
         trackers = None
         if window > 1:
             trackers = GDNRecoverTrackers(
@@ -2240,7 +2258,7 @@ class QwenGatedDeltaNetAttention(GatedDeltaNetAttention):
             self.A_log,
             self.dt_bias,
             ssm_state,
-            GDNRecoverRecords(rec_u, rec_k, rec_g),
+            records,
             cu_seqlens=spec_query_start_loc[: attn_metadata.num_spec_decodes + 1],
             slot_indices=spec_state_indices[:, 0],
             out=out[0],
diff --git a/vllm/model_executor/layers/mamba/mamba_utils.py b/vllm/model_executor/layers/mamba/mamba_utils.py
index 7b8c8f425..9db714a87 100644
--- a/vllm/model_executor/layers/mamba/mamba_utils.py
+++ b/vllm/model_executor/layers/mamba/mamba_utils.py
@@ -64,6 +64,14 @@ def gdn_spec_recover_enabled(num_spec: int) -> bool:
     return num_spec > 0 and envs.VLLM_GDN_SPEC_STATE.lower() == "recover"
 
 
+def gdn_spec_recover_ring_in_page(num_spec: int) -> bool:
+    """Recover mode keeps its record ring in the Mamba page only for W > 1
+    (records pending across steps). With W = 1 the records live in a
+    per-step buffer, so the page -- and with prefix caching the hybrid block
+    size -- is identical to the per-token path's."""
+    return gdn_spec_recover_enabled(num_spec) and gdn_spec_recover_window() > 1
+
+
 def gdn_spec_recover_window() -> int:
     """Commit window W of VLLM_GDN_SPEC_STATE=recover (VLLM_GDN_SPEC_STATE_W)."""
     window = envs.VLLM_GDN_SPEC_STATE_W
@@ -151,7 +159,7 @@ class MambaStateDtypeCalculator:
         dtypes = cls._mamba_state_dtype(
             model_dtype, mamba_cache_dtype, mamba_ssm_cache_dtype
         )
-        if gdn_spec_recover_enabled(num_spec):
+        if gdn_spec_recover_ring_in_page(num_spec):
             # Record rings (u, k, g): fp32, activation dtype, fp32.
             activation_dtype = get_kv_cache_torch_dtype("auto", model_dtype)
             dtypes = (*dtypes, torch.float32, activation_dtype, torch.float32)
@@ -318,7 +326,7 @@ class MambaStateShapeCalculator:
             head_v_dim,
             head_k_dim,
         )
-        if gdn_spec_recover_enabled(num_spec):
+        if gdn_spec_recover_ring_in_page(num_spec):
             from vllm.model_executor.layers.mamba.ops.gdn_recover_spec import (
                 gdn_recover_ring_shapes,
             )
