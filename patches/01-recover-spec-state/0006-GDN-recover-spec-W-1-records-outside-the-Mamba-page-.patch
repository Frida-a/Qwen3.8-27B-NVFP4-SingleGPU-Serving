diff --git a/tests/v1/core/test_mamba_recover_spec_caching.py b/tests/v1/core/test_mamba_recover_spec_caching.py
new file mode 100644
index 000000000..5fa714700
--- /dev/null
+++ b/tests/v1/core/test_mamba_recover_spec_caching.py
@@ -0,0 +1,114 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Prefix caching with GDN spec decode: per-token state columns
+(num_speculative_blocks = K) vs VLLM_GDN_SPEC_STATE=recover (one running
+block, num_speculative_blocks = 0) must cache exactly the same Mamba blocks
+for the same request sequence, so a follow-up turn gets the same hit.
+
+(At equal block size. Recover W > 1 keeps its record ring in the Mamba page,
+which grows the page and therefore the hybrid block size; W = 1 keeps the
+page identical to the per-token path's.)
+"""
+
+import random
+
+import pytest
+import torch
+
+from vllm.sampling_params import SamplingParams
+from vllm.utils.hashing import sha256
+from vllm.v1.core.kv_cache_utils import get_request_block_hasher
+from vllm.v1.kv_cache_interface import MambaSpec
+from vllm.v1.outputs import DraftTokenIds, ModelRunnerOutput
+from vllm.v1.request import Request, RequestStatus
+
+from .utils import EOS_TOKEN_ID, create_requests, create_scheduler
+
+pytestmark = pytest.mark.cpu_test
+
+BLOCK_SIZE = 16
+NUM_SPEC = 3
+
+
+def _request(req_id: str, prompt: list[int], max_tokens: int) -> Request:
+    params = SamplingParams(max_tokens=max_tokens, ignore_eos=True)
+    params.update_from_generation_config({}, EOS_TOKEN_ID)
+    return Request(
+        request_id=req_id,
+        prompt_token_ids=prompt,
+        sampling_params=params,
+        pooling_params=None,
+        block_hasher=get_request_block_hasher(BLOCK_SIZE, sha256),
+    )
+
+
+def _run(num_speculative_blocks: int, prompt_len: int, accepted: list[int]):
+    scheduler = create_scheduler(
+        model="Qwen/Qwen3-0.6B",
+        enable_prefix_caching=True,
+        num_speculative_tokens=NUM_SPEC,
+        speculative_method="ngram_gpu",
+        block_size=BLOCK_SIZE,
+        kv_cache_spec=MambaSpec(
+            block_size=BLOCK_SIZE,
+            shapes=((1, 1),),
+            dtypes=(torch.float32,),
+            mamba_cache_mode="align",
+            num_speculative_blocks=num_speculative_blocks,
+        ),
+    )
+    create_requests(num_requests=1, block_size=BLOCK_SIZE)  # init the none hash
+    prompt = [(7 * i) % 50 + 1 for i in range(prompt_len)]
+    req = _request("turn1", prompt, max_tokens=10_000)
+    scheduler.add_request(req)
+    # Prefill (possibly chunked) until the first sampled token.
+    while True:
+        out = scheduler.schedule()
+        done = req.num_computed_tokens + out.num_scheduled_tokens[req.request_id]
+        sampled = [[1000]] if done >= len(prompt) else [[]]
+        scheduler.update_from_output(
+            out, ModelRunnerOutput(req_ids=[req.request_id], sampled_token_ids=sampled)
+        )
+        if done >= len(prompt):
+            break
+    # Spec decode steps crossing several block boundaries.
+    next_tok = 1001
+    for a in accepted:
+        scheduler.update_draft_token_ids(
+            DraftTokenIds([req.request_id], [list(range(2000, 2000 + NUM_SPEC))])
+        )
+        out = scheduler.schedule()
+        assert out.num_scheduled_tokens[req.request_id] == 1 + NUM_SPEC
+        toks = list(range(next_tok, next_tok + a))
+        next_tok += a
+        scheduler.update_from_output(
+            out, ModelRunnerOutput(req_ids=[req.request_id], sampled_token_ids=[toks])
+        )
+    turn1_tokens = list(req.all_token_ids)
+    pool = scheduler.kv_cache_manager.block_pool
+    cached = [
+        i
+        for i, h in enumerate(req.block_hashes)
+        if pool.get_cached_block(h, kv_cache_group_ids=[0]) is not None
+    ]
+    scheduler.finish_requests(req.request_id, RequestStatus.FINISHED_STOPPED)
+    # Turn 2: the whole turn-1 sequence plus a new user turn.
+    req2 = _request("turn2", turn1_tokens + list(range(3000, 3040)), max_tokens=4)
+    _, hit, _ = scheduler.kv_cache_manager.get_computed_blocks(req2)
+    return cached, hit, len(turn1_tokens)
+
+
+@pytest.mark.parametrize("seed", range(4))
+@pytest.mark.parametrize("prompt_len", [37, 45, 64])
+def test_recover_caches_same_blocks_as_per_token(seed, prompt_len):
+    rng = random.Random(seed)
+    accepted = [rng.randint(1, NUM_SPEC + 1) for _ in range(25)]
+    per_token = _run(NUM_SPEC, prompt_len, accepted)
+    recover = _run(0, prompt_len, accepted)
+    cached_pt, hit_pt, n_tokens = per_token
+    cached_rec, hit_rec, _ = recover
+    # Decode crossed block boundaries and published some of them.
+    assert n_tokens > prompt_len + 2 * BLOCK_SIZE
+    assert cached_pt, "per-token path cached nothing"
+    assert cached_rec == cached_pt
+    assert hit_rec == hit_pt
