+@pytest.mark.parametrize("window", [2, 4])
+def test_flush_at_finish_and_slot_reuse(window):
+    """W > 1: a request finishing (or preempted) with pending records is
+    force-folded (flush); a new request reusing the slot starts clean."""
+    N, t_max = 3, 4
+    gen = torch.Generator(device=DEV).manual_seed(40 + window)
+    A_log, dt_bias = _params(gen)
+    state, rec = _new_cache(N, gen, num_spec=t_max - 1, window=window)
+    slots = torch.arange(1, N + 1, dtype=torch.int32, device=DEV)
+    zeros = torch.zeros(state.shape[0], dtype=torch.int32, device=DEV)
+    tr = GDNRecoverTrackers(zeros.clone(), zeros.clone())
+    group = GDNRecoverCommitGroup(
+        [state], [rec], num_k_heads=H, window=window, trackers=tr
+    )
+
+    def step(s_ref, acc_list):
+        st = _Step([t_max] * N, gen)
+        o_ref, pool, idx = _reference(st, A_log, dt_bias, s_ref, t_max)
+        out = torch.empty((st.T, HV, V), device=DEV, dtype=torch.bfloat16)
+        gdn_recover_verify(
+            st.q, st.k, st.v, st.a, st.b, A_log, dt_bias,
+            state, rec, st.cu, slots, out=out, window=window, trackers=tr,
+        )  # fmt: skip
+        _assert_bitexact(out, o_ref, "verify output")
+        acc = torch.tensor(acc_list, dtype=torch.int32, device=DEV)
+        group.commit(slots, st.cu, acc)
+        return pool[idx[torch.arange(N), acc.long() - 1].long()]
+
+    s_ref = step(state[1:].clone(), [1, 2, 1])
+    assert int(tr.num_pending[1]) == 1  # request 0 has a pending record
+    # Request 0 finishes / is preempted: fold its pending records only.
+    group.flush(slots[:1])
+    assert int(tr.num_pending[1]) == 0
+    _assert_bitexact(state[1], s_ref[0], "flushed state")
+    # A new request takes slot 1 with a fresh (prefilled) state; the others
+    # keep their pending records.
+    fresh = torch.randn(state.shape[1:], generator=gen, device=DEV)
+    state[1] = fresh
+    s_ref = torch.cat([fresh[None], s_ref[1:]])
+    s_ref = step(s_ref, [2, 1, 1])
+    s_ref = step(s_ref, [4, 3, 2])
+    group.flush(slots)
+    assert int(tr.num_pending.abs().sum()) == 0
+    _assert_bitexact(state[1:], s_ref, "states after reuse and final flush")
+
+
