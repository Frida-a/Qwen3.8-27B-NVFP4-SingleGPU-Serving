+@torch.inference_mode()
+def test_window_prefill_reads_and_slot_reuse(monkeypatch):
+    """Request A keeps decoding; request B is resumed as a prefill chunk
+    (reads its state with records pending), then finishes and its slot goes
+    to a new request C (fresh prefill, stale trackers)."""
+    init, params = _setup(2, seed=7)
+    gen = torch.Generator().manual_seed(7)
+    # (seq_lens, query_lens, drafts): A first (spec decodes lead the batch).
+    schedule = [
+        ([70, 70], [T, T], [3, 3]),
+        ([74, 74], [T, T], [3, 3]),
+        ([78, 78], [T, T], [3, 3]),
+        ([82, 90], [T, 3], [3, -1]),  # B: prefill chunk with initial state
+        ([86, 94], [T, T], [3, 3]),
+        ([90, 5], [T, 5], [3, -1]),  # C reuses B's slot: fresh prefill
+        ([94, 9], [T, T], [3, 3]),
+        ([98, 13], [T, T], [3, 3]),
+    ]
+    inputs = [_inputs(sum(q)) for _, q, _ in schedule]
+    # B's acceptances leave records pending (W = 3) when its prefill chunk
+    # (step 3) and C's fresh prefill on the same slot (step 5) arrive.
+    b_sampled = [4, 1, 1, 1, 1, 1, None, None]
+    sampled = []
+    for i, (_, ql, dr) in enumerate(schedule):
+        a = int(torch.randint(1, ql[0] + 1, (1,), generator=gen))
+        b = b_sampled[i]
+        if b is None:
+            b = int(torch.randint(1, ql[1] + 1, (1,), generator=gen))
+        sampled.append(torch.tensor([a, b], dtype=torch.int32))
+    results = {}
+    for window in (1, 3):
+        run = _Run(monkeypatch, "recover", window, 2, init, params)
+        outs = []
+        for i, (sl, ql, dr) in enumerate(schedule):
+            if window > 1 and i in (3, 5):
+                # B's slot (2) has pending records when the prefill reads it.
+                assert int(run.layer._replayssm_prev_num_accepted[2]) > 0
+            outs.append(run.step(sl, ql, dr, *inputs[i], sampled[i].to(DEV)))
+        conv = run.conv[run.table[:, 0].long()].clone()
+        results[window] = (outs, conv, run.final_states())
+    (o1, c1, s1), (o3, c3, s3) = results[1], results[3]
+    for i in range(len(schedule)):
+        _assert_same(o3[i], o1[i], f"output step {i}")
+    _assert_same(c3, c1, "conv state")
+    _assert_same(s3, s1, "final states")
